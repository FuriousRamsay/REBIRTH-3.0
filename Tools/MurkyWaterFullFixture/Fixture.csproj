<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
<ItemGroup><Compile Include="Program.cs"/></ItemGroup>
<Target Name="ExtractCurrentLiquid" BeforeTargets="CoreCompile"><PropertyGroup>
<LiquidIntermediate Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)</LiquidIntermediate>
<LiquidIntermediate Condition="!$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)'))</LiquidIntermediate>
<LiquidGenerated>$([System.IO.Path]::Combine('$(LiquidIntermediate)', 'ActualLiquid.cs'))</LiquidGenerated>
</PropertyGroup><Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/ExtractSource.ps1&quot; -Output &quot;$(LiquidGenerated)&quot;"/><ItemGroup><Compile Include="$(LiquidGenerated)"/></ItemGroup></Target></Project>
