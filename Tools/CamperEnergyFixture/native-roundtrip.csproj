    <RebirthManagedRoot>$(RebirthGameRoot)\7DaysToDie_Data\Managed</RebirthManagedRoot>
  </PropertyGroup>
  <ItemGroup><Compile Include="NativeRuntimeRoundtrip.cs"/>
