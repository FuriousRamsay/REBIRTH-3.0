    { "click": { "window": "rebirthCompanions", "id": "btnTabEquipment" } },
    { "expectUi": { "window": "rebirthCompanions", "id": "npcEquipSlot179" } },
    { "expectUi": { "window": "rebirthCompanions", "id": "npcEquipSelected" } },
    { "screenshot": "n07_first_equipment_open" },
