    { "spawn": { "entity": "zombieArlene", "distance": 5 } },
    { "fight": { "contains": "zombie" } },
    { "expectLog": { "contains": "[REBIRTH WeaponBonus] RangedBleed", "min": 1 } },
    { "console": "rbweaponbonus force off" },
    { "cleararea": { "radius": 60 } },
    { "expectNoErrors": true }
  ]
