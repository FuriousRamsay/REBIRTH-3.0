{
  "name": "Cooking: bake a potato at the spawn campfire through the UI",
  "stopOnFailure": true,
  "preconditions": "Fresh disposable TestProfile4 clone: campfire at 14,45,995 has one ready grilled-meat job, a grill and fuel; cooking pot and raw potatoes are in the backpack. Run only after resetting CodexTest from that baseline.",
  "steps": [
    {
      "_note": "Disposable CodexTest baseline: campfire14,45,995 has a ready grilled-meat job, grill and fuel; potatoes and cooking pot are in the backpack. Collect the old job and install the pot before marking baked-potato output."
    },
    {
      "walkto": {
        "x": 14.5,
        "z": 993.3,
        "radius": 0.7
      }
    },
    {
      "activate": {
        "x": 14,
        "y": 45,
        "z": 995,
        "block": 1
      }
    },
    {
      "expectWindowOpen": "workstation_campfire"
    },
    {
      "click": {
        "id": "rebirthCookingTake",
        "window": "workstation_campfire"
      }
    },
    {
      "wait": 0.5
    },
    {
      "expectNoUi": {
        "text": "READY TO TAKE",
        "window": "workstation_campfire"
      }
    },
    {
      "drag": {
        "from.item": "toolCookingPot",
        "to.path": "workstation_campfire/rebirthCookingRoot/station/cookingTools/content/inventory/0"
      }
    },
    {
      "click": {
        "text": "Baked Potato",
        "window": "workstation_campfire"
      }
    },
    {
      "click": {
        "text": "PULL INGREDIENTS",
        "window": "workstation_campfire"
      }
    },
    {
      "expectUi": {
        "item": "foodCropPotato",
        "window": "workstation_campfire"
      }
    },
    {
      "expectUi": {
        "text": "Ready to cook",
        "window": "workstation_campfire"
      }
    },
    {
      "markItem": "foodBakedPotato"
    },
    {
      "click": {
        "text": "COOK",
        "window": "workstation_campfire"
      }
    },
    {
      "screenshot": "cooking_started"
    },
    {
      "waitForUi": {
        "path": "workstation_campfire/rebirthCookingRoot/rebirthCraftingQueueRegion/rebirthCraftingQueueController/rebirthCraftingQueueRowsHost/rebirthCraftingQueueSlot3/rebirthQueueName",
        "text": "Baked Potato",
        "timeout": 30
      }
    },
    {
      "waitForUi": {
        "text": "READY TO TAKE",
        "window": "workstation_campfire",
        "timeout": 120
      }
    },
    {
      "click": {
        "id": "rebirthCookingTake",
        "window": "workstation_campfire"
      }
    },
    {
      "expectItemDelta": {
        "name": "foodBakedPotato",
        "op": "==",
        "value": 1
      }
    },
    {
      "click": {
        "text": "Turn Off",
        "window": "workstation_campfire"
      }
    },
    {
      "key": {
        "name": "Escape"
      }
    },
    {
      "expectNoErrors": true
    }
  ]
}
