{
  "name": "Cooking: bake a potato at the spawn campfire through the UI",
  "stopOnFailure": true,
  "steps": [
    {
      "_note": "Prepared disposable CodexTest: campfire14,45,995 fueled and no active batch; potatoes in backpack. COOK starts heat. Guard stays enabled. Output is checked as a delta, not an existing inventory count."
    },
    {
      "walkto": {
        "x": 14.5,
        "z": 993.3,
        "radius": 0.7
      }
    },
    {
      "activate": {
        "x": 14,
        "y": 45,
        "z": 995,
        "block": 1
      }
    },
    {
      "expectWindowOpen": "workstation_campfire"
    },
    {
      "click": {
        "text": "Baked Potato",
        "window": "workstation_campfire"
      }
    },
    {
      "click": {
        "text": "PULL INGREDIENTS",
        "window": "workstation_campfire"
      }
    },
    {
      "expectUi": {
        "item": "foodCropPotato",
        "window": "workstation_campfire"
      }
    },
    {
      "markItem": "foodBakedPotato"
    },
    {
      "click": {
        "text": "COOK",
        "window": "workstation_campfire"
      }
    },
    {
      "screenshot": "cooking_started"
    },
    {
      "waitForUi": {
        "text": "READY TO TAKE",
        "window": "workstation_campfire",
        "timeout": 120
      }
    },
    {
      "click": {
        "id": "rebirthCookingTake",
        "window": "workstation_campfire"
      }
    },
    {
      "expectItemDelta": {
        "name": "foodBakedPotato",
        "op": "==",
        "value": 1
      }
    },
    {
      "click": {
        "text": "Turn Off",
        "window": "workstation_campfire"
      }
    },
    {
      "key": {
        "name": "Escape"
      }
    },
    {
      "expectNoErrors": true
    }
  ]
}
