    {
      "_note": "Run after a fresh diagnostic launch with native freezepos initially OFF. Guard must stay enabled. This checks structural/native binding and forced transitions; visual quality and melee/ranged remain separate."
    },
    {
      "surroundings": {}
    },
    {
      "cleararea": {
        "radius": 60
      }
    },
    {
      "restore": {}
    },
