      "cleararea": {
        "radius": 60
      }
    },
    {
      "spawn": {
        "entity": "RebirthNurse",
        "distance": 30
      }
    },
    {
      "wait": 1
    },
    {
      "expectEntityStudio": {
        "entityClass": "RebirthNurse",
        "checks": [
          {
            "field": "modelCapsules",
            "op": "==",
            "value": 11
          },
          {
            "field": "ragdollRigidbodies",
            "op": "==",
            "value": 11
