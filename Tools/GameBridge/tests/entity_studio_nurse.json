            "op": "==",
            "value": 0
          },
          {
            "field": "controller.type",
            "op": "==",
            "value": "CharacterControllerKinematic"
          },
          {
            "field": "controller.height",
            "op": ">",
            "value": 0,
            "tolerance": 0.001
          },
          {
            "field": "controller.radius",
            "op": ">",
            "value": 0,
            "tolerance": 0.001
