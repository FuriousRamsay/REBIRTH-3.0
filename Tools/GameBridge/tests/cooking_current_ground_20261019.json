{
  "name": "Current-build ground campfire: pull, cook, take once",
  "stopOnFailure": true,
  "steps": [
    { "click": { "text": "Baked Potato", "window": "workstation_campfire" } },
    { "click": { "text": "PULL INGREDIENTS", "window": "workstation_campfire" } },
    { "expectUi": { "item": "foodCropPotato", "window": "workstation_campfire" } },
    { "markItem": "foodBakedPotato" },
    { "key": { "name": "W" } },
    { "waitForUi": { "text": "READY TO TAKE", "window": "workstation_campfire", "timeout": 120 } },
    { "key": { "name": "R" } },
    { "expectItemDelta": { "name": "foodBakedPotato", "op": "==", "value": 1 } },
    { "key": { "name": "Escape" } },
    { "expectStation": { "x": 20, "y": 44, "z": 1075, "station": "campfire", "field": "queueCount", "op": "==", "value": 0 } },
    { "expectNoErrors": true }
  ],
  "preconditions": "Disposable CodexTest. Ground campfire at (20,44,1075) with pot and wood installed; open workstation; raw potato in backpack."
}
