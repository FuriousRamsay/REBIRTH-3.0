{
  "name": "p16_harvest_observation_solo",
  "stopOnFailure": true,
  "steps": [
    {
      "_note": "Run in an isolated loaded Purge save with a completed Survivor, closed UI, clear surroundings and reachable live targets. Copy this file to temp and replace every @TOKEN@ with the measured position, toolbelt slot, native hold duration or exact baseline item delta. Use identical tool, position, capacity, damage, and progression for baseline and candidate. No direct mutation or synthetic award. Confirm actual crosshair target with the bridge before opening the batch."
    },
    {
      "_note": "Solo positive discrete evidence only. Use a mature authored *3HarvestPlayer crop with an actual inventory award, an eligible configured dead carcass, and salvage with a positively weighted result. For each, verify exact item delta, intended skill increase and untouched Mining/Logging counterpart. Repeat partial/full bag and unweighted salvage as separate controls using their captured baseline; a full-bag drop is not carried evidence. Dedicated actors require a separate baseline per P16-08 before expecting any practical training gain."
    },
    {
      "markItem": "resourceRockSmall"
    },
    {
      "markSkill": "skill.mining"
    },
    {
      "markSkill": "skill.logging"
    },
    {
      "action": {
        "command": "select",
        "args": {
          "slot": "@ORE_SLOT@"
        }
      }
    },
    {
      "action": {
        "command": "lookat",
        "args": {
          "x": "@ORE_X@",
          "y": "@ORE_Y@",
          "z": "@ORE_Z@",
          "block": 1
        }
      }
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "Primary",
          "seconds": "@ORE_SECONDS@"
        }
      }
    },
    {
      "expectItemDelta": {
        "name": "resourceRockSmall",
        "op": "==",
        "value": "@ORE_DELTA@"
      }
    },
    {
      "expectCvar": {
        "name": "$rbSurvivorSkillResourceHarvest",
        "op": "==",
        "value": 0
      }
    },
    {
      "expectSkillGain": {
        "skill": "skill.mining",
        "op": ">",
        "value": 0
      }
    },
    {
      "expectSkillGain": {
        "skill": "skill.logging",
        "op": "==",
        "value": 0
      }
    },
    {
