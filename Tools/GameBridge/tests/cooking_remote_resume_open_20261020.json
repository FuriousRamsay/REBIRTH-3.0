{
  "name": "Dedicated remote cooking continuation from open campfire",
  "stopOnFailure": true,
  "preconditions": "Disposable CodexTest remote client is in the already-open campfire at (-272,61,451), with pot, wood, and potatoes supplied by the initial scenario; continue without restarting either process.",
  "steps": [
    {
      "expectStation": {
        "x": -272,
        "y": 61,
        "z": 451,
        "station": "campfire",
        "field": "queueCount",
        "op": "==",
        "value": 0,
        "allowOpen": true
      }
    },
    {
      "click": {
        "item": "toolCookingPot",
        "shift": 1,
        "window": "workstation_campfire"
      }
    },
    {
      "click": {
        "item": "resourceWood",
        "shift": 1,
        "window": "workstation_campfire"
      }
    },
    {
      "click": {
        "text": "Turn On",
        "window": "workstation_campfire"
      }
    },
    {
      "click": {
        "text": "Baked Potato",
        "window": "workstation_campfire"
      }
    },
    {
      "markItem": "foodCropPotato"
    },
    {
      "click": {
        "id": "pullIngredients",
        "window": "workstation_campfire"
      }
    },
    {
      "expectItemDelta": {
        "name": "foodCropPotato",
        "op": "==",
        "value": -1
      }
    },
    {
      "expectUi": {
        "item": "foodCropPotato",
        "window": "workstation_campfire"
      }
    },
    {
      "markItem": "foodBakedPotato"
    },
    {
      "click": {
        "text": "COOK",
        "window": "workstation_campfire"
      }
    },
    {
      "waitForUi": {
        "text": "READY TO TAKE",
        "window": "workstation_campfire",
        "timeout": 120
      }
    },
    {
      "click": {
        "id": "rebirthCookingTake",
        "window": "workstation_campfire"
      }
    },
    {
      "expectItemDelta": {
        "name": "foodBakedPotato",
        "op": "==",
        "value": 1
      }
    },
    {
      "key": {
        "name": "Escape"
      }
    },
    {
      "expectStation": {
        "x": -272,
        "y": 61,
        "z": 451,
        "station": "campfire",
        "field": "queueCount",
        "op": "==",
        "value": 0
      }
    },
    {
      "expectNoErrors": true
    }
  ]
}
