          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "stationCount",
            "op": "==",
            "value": 3
          }
        ]
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "permanent.Activate",
          "hold": 1
        }
      }
    },
    {
      "wait": 0.9
    },
    {
      "action": {
        "command": "hover",
        "args": {
          "x": 520,
          "y": 308
        }
      }
    },
    {
      "action": {
        "command": "release",
        "args": {
          "action": "permanent.Activate"
        }
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthCamperStationManagement",
        "timeout": 8
      }
    },
    {
      "expectWindowOpen": "rebirthCamperStationManagement"
    },
    {
      "expectItemDelta": {
