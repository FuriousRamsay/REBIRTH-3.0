{
  "name": "Station bidirectional gestures preserving existing stations",
  "stopOnFailure": true,
  "steps": [
    {
      "action": {
        "command": "give",
        "args": {
          "item": "campfire",
          "count": 1
        }
      }
    },
    {
      "markItem": "campfire"
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "permanent.Activate",
          "hold": 1
        }
      }
    },
    {
      "wait": 0.9
    },
    {
      "action": {
        "command": "hover",
        "args": {
          "x": 520,
          "y": 308
        }
      }
    },
    {
      "action": {
        "command": "release",
        "args": {
          "action": "permanent.Activate"
        }
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthCamperStationManagement",
        "timeout": 8
      }
    },
    {
      "expectWindowOpen": "rebirthCamperStationManagement"
    },
    {
      "action": {
        "command": "click",
        "args": {
          "item": "campfire",
          "shift": 1
        }
      }
    },
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 8,
        "checks": [
          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "stationCount",
            "op": "==",
            "value": 3
          }
        ]
      }
    },
    {
      "expectItemDelta": {
        "name": "campfire",
        "op": "==",
        "value": -1
      }
    },
    {
      "action": {
        "command": "click",
        "args": {
          "id": "camperModule2",
          "shift": 1
        }
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 8,
        "checks": [
          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "stationCount",
            "op": "==",
            "value": 2
          }
        ]
      }
    },
    {
      "expectItemDelta": {
        "name": "campfire",
        "op": "==",
        "value": 0
      }
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "permanent.Activate",
          "hold": 1
        }
      }
    },
    {
      "wait": 0.9
    },
    {
      "action": {
        "command": "hover",
        "args": {
          "x": 520,
          "y": 308
        }
      }
    },
    {
      "action": {
        "command": "release",
        "args": {
          "action": "permanent.Activate"
        }
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthCamperStationManagement",
        "timeout": 8
      }
    },
    {
      "expectWindowOpen": "rebirthCamperStationManagement"
    },
    {
      "action": {
        "command": "drag",
        "args": {
          "from.item": "campfire",
          "to.id": "camperModule2"
        }
      }
    },
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 8,
