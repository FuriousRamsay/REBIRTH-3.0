{
  "name": "Player reports local cleaver and hunting-rifle progress",
  "stopOnFailure": true,
  "preconditions": "Authorized disposable completed REBIRTH character, god mode off, guard on, flat open combat ground and no full UI window. This tests the current character only; record its background/traits separately.",
  "steps": [
    { "cleararea": { "radius": 40 } },
    { "restore": {} },
    { "give": { "item": "ItemsWeaponsCleaver001_FR", "quality": 2, "toolbelt": 1 } },
    { "select": { "slot": 2 } },
    { "wait": 1 },
    { "select": { "slot": 1 } },
    { "console": "rbskill audit" },
    { "markSkill": "skill.knives" },
    { "spawn": { "entity": "zombieArlene", "distance": 6 } },
    { "fight": { "contains": "zombie", "radius": 20, "maxSeconds": 60 } },
    { "wait": 2 },
    { "expectSkillGain": { "skill": "skill.knives", "op": ">", "value": 0 } },
    { "console": "rbskill audit" },
    { "cleararea": { "radius": 40 } },
    { "restore": {} },
    { "give": { "item": "gunRifleT1HuntingRifle", "quality": 2, "toolbelt": 1 } },
    { "give": { "item": "ammo762mmBulletBall", "count": 60 } },
    { "select": { "slot": 1 } },
    { "key": { "name": "R" } },
    { "wait": 6 },
    { "console": "rbskill audit" },
    { "markSkill": "skill.long_range_rifles" },
    { "spawn": { "entity": "zombieArlene", "distance": 12 } },
    { "fight": { "contains": "zombie", "radius": 24, "maxSeconds": 60 } },
    { "wait": 2 },
    { "expectSkillGain": { "skill": "skill.long_range_rifles", "op": ">", "value": 0 } },
    { "console": "rbskill audit" },
    { "expectNoErrors": true }
  ]
}
