  {
    "id": 5,
    "title": "NPC after remote world transition",
    "mode": "remote",
    "setup": "Exit to menu and reconnect to the same disposable Purge server in the same client process. Record the player-spawn projection warning separately. If an existing REBIRTH Survivor is available on the authority, start outside its client streaming range and supply movement toward it and its class match. Record the authority and client entity IDs and review the exact incoming spawn exception. Leave the fixture unavailable if there is no existing Survivor.",
    "review": true,
    "domain": "npcRecovery",
    "steps": [
      {
        "action": {
          "command": "walkto",
          "args": {
            "fixture": "walk"
          }
        }
      },
      {
        "wait": 8
      },
      {
        "expectLivingEntities": {
          "contains": {
            "fixture": "entity"
          },
          "radius": 28,
          "op": ">=",
          "value": 1
        }
      },
      {
        "expectNoLog": {
          "contains": "Exact original client projection group unavailable",
          "level": "error"
        }
      }
    ]
  },
