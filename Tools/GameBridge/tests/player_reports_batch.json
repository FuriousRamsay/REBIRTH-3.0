  {
    "id": 7,
    "title": "Running stone pickups",
    "mode": "remote",
    "setup": "Locate five natural rocks in the current isolated save and verify each on the host. Aim low and confirm the exact rock coordinate in the client target before running and tapping native Activate. Include a rapid second tap on the same rock in at least one trial. Capture the HUD immediately after each input, and record the host block and client stone count before and after each attempt. A missed aim or missing block is not a pickup trial.",
    "review": true,
    "domain": "nativeInventory",
    "steps": [
      {
        "markItem": "resourceRockSmall"
      },
      {
        "fixture": "route"
      },
      {
        "expectNoUi": {
          "text": "The block changed before pickup completed."
        }
      },
      {
        "wait": 2
      },
      {
        "expectItemDelta": {
          "name": "resourceRockSmall",
          "op": "==",
          "value": 5
        }
      },
      {
        "expectNoLog": {
          "contains": "The block changed before pickup completed."
        }
      },
      {
        "screenshot": "stone_pickup"
