        "expectStat": {
          "name": "health",
          "op": "==",
          "value": {
            "fixture": "health"
          }
        }
      },
      {
        "action": {
          "command": "state",
          "args": {
            "sections": "stats,buffs"
          }
        }
      },
      {
        "wait": {
          "fixture": "seconds"
        }
      },
      {
        "expectStat": { "name": "food", "op": "==", "value": 0 }
      },
      {
        "expectStat": { "name": "water", "op": ">=", "value": 90 }
      },
      {
        "expectNoBuff": "buffHealHealth"
      },
      {
        "expectStat": {
          "name": "health",
          "op": "<",
          "value": {
            "fixture": "health"
          }
        }
      },
      {
        "action": {
          "command": "state",
          "args": {
            "sections": "stats,buffs"
          }
        }
      }
    ]
