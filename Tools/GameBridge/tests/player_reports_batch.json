    "review": true,
    "domain": "restorationOriginal",
    "steps": [
      {
        "markItem": "resourceHeadlight"
      },
      {
        "action": {
          "command": "drag",
          "args": {
            "fixture": "drag"
          }
        }
      },
      {
        "wait": 5
      },
      {
        "expectItemDelta": {
          "name": "resourceHeadlight",
          "op": "==",
          "value": -1
