{
  "name": "Campfire processing: real UI cancel, confirmed Chemistry credit, no Cooking cross-credit",
  "stopOnFailure": true,
  "steps": [
    {"_note":"CodexTest campfire 14,45,995 must contain a pot and burning fuel. Start with all windows closed. Uses native radial activation at the configured 1280x720 resolution. Supplies are setup only; all crafting/cancellation use the real UI."},
    {"action":{"command":"cleararea","args":{"radius":40}}},
    {"action":{"command":"restore"}},
    {"action":{"command":"give","args":{"item":"resourceBone","count":14}}},
    {"action":{"command":"give","args":{"item":"drinkJarBoiledWater","count":2}}},
    {"action":{"command":"walkto","args":{"x":14.5,"z":993.3,"radius":0.7}}},
    {"action":{"command":"lookat","args":{"x":14,"y":45,"z":995,"block":1}}},
    {"action":{"command":"press","args":{"action":"permanent.Activate","hold":1}}},
    {"wait":1},
    {"action":{"command":"hover","args":{"x":565,"y":335}}},
    {"action":{"command":"release","args":{"action":"permanent.Activate"}}},
    {"expectWindowOpen":"rebirthCampfireProcessingWindow"},
    {"expectNoUi":{"recipe":"foodBakedPotato","window":"rebirthCampfireProcessingWindow"}},
    {"action":{"command":"click","args":{"recipe":"resourceGlue","window":"rebirthCampfireProcessingWindow"}}},
    {"markSkill":"skill.chemistry"},
    {"markSkill":"skill.cooking"},
    {"action":{"command":"click","args":{"text":"Cook","window":"rebirthCampfireProcessingWindow"}}},
    {"action":{"command":"click","args":{"path":"rebirthCampfireProcessingWindow/windowCraftingQueue/rect/queue/3/background"}}},
    {"wait":14},
    {"expectSkillGain":{"skill":"skill.chemistry","op":"==","value":0}},
    {"action":{"command":"click","args":{"text":"Cook","window":"rebirthCampfireProcessingWindow"}}},
    {"wait":14},
    {"expectUi":{"item":"resourceGlue","window":"rebirthCampfireProcessingWindow"}},
    {"expectSkillGain":{"skill":"skill.chemistry","op":">","value":0.015}},
    {"expectSkillGain":{"skill":"skill.chemistry","op":"<","value":0.03}},
    {"expectSkillGain":{"skill":"skill.cooking","op":"==","value":0}},
    {"markSkill":"skill.chemistry"},
    {"wait":3},
    {"expectSkillGain":{"skill":"skill.chemistry","op":"==","value":0}},
    {"screenshot":"campfire_processing_pass"},
    {"action":{"command":"key","args":{"name":"Escape"}}},
    {"expectNoErrors":true}
  ]
}
