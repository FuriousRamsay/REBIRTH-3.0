    {
      "expectStation": {
        "x": 19,
        "y": 45,
        "z": 997,
        "station": "cntCollapsedChemistryStation",
        "field": "queueCount",
        "op": "==",
        "value": 0
      }
    },
    {
      "expectStation": {
