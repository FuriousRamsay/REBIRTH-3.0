{
  "name": "Berserker rage (2.6 port): Defensive, Offensive with a capsule, shared capsule, Death Rage, Blood Moon Rage",
  "stopOnFailure": true,
  "steps": [
    { "_note": "Run on open ground away from vehicles: the knockdown throws enemies, and a parked vehicle kills them. rbrage pagedown/pageup run the same code as the Page Down/Page Up keys, which the bridge cannot press (it sends input actions, not raw keys)." },
    { "cleararea": { "radius": 40 } },
    { "console": "settime 8 9 0" },
    { "console": "rbtestgrant berserker all" },
    { "console": "rbtestgrant skill skill.rage 20" },
    { "console": "rbrage clear" },
    { "wait": 1 },
    { "give": { "item": "meleeWpnClubT1BaseballBat", "toolbelt": 1 } },
    { "select": { "slot": 1 } },

    { "_note": "Defensive Rage, rank 3 at Rage 20: 60 s, knockdown 15 damage to the zombie next to the player, then a 170 s cooldown." },
    { "spawn": { "entity": "zombieMoe", "distance": 1.5 } },
    { "console": "rbrage pagedown" },
    { "wait": 1 },
    { "expectBuff": "rebirthRageDefensive" },
    { "expectCvar": { "name": "$rbRageDefRank", "op": "==", "value": 3 } },
    { "expectCvar": { "name": "$rbRageDefApm", "op": "==", "value": 0.6 } },
    { "expectLog": { "contains": "[REBIRTH Rage] knockdown rank 3", "min": 1 } },
    { "expectCvar": { "name": "$rbRageLeftDefensive", "op": ">", "value": 50 } },
    { "screenshot": "rage_defensive" },
    { "cleararea": { "radius": 40 } },
    { "console": "rbrage pagedown" },
    { "expectBuff": "rebirthRageDefensive" },

    { "_note": "Offensive Rage needs Rage 50 and a capsule: rank 8, 100 s, the capsule is used; ending it starts the 120 s cooldown." },
    { "console": "rbrage clear" },
    { "console": "rbtestgrant skill skill.rage 50" },
    { "wait": 1 },
    { "markItem": "rebirthRageCapsule" },
    { "give": { "item": "rebirthRageCapsule", "count": 1 } },
    { "console": "rbrage pageup" },
    { "wait": 1 },
    { "expectBuff": "rebirthRageOffensive" },
    { "expectItemDelta": { "name": "rebirthRageCapsule", "op": "==", "value": 0 } },
    { "expectCvar": { "name": "$rbRageOffRank", "op": "==", "value": 8 } },
    { "expectCvar": { "name": "$rbRageOffSeconds", "op": "==", "value": 100 } },
    { "expectCvar": { "name": "$rbRageOffCarry", "op": "==", "value": 40 } },
    { "console": "rbrage clear" },
    { "wait": 1 },
    { "expectBuff": "rebirthRageOffensiveCooldown" },

    { "_note": "Rage Capsule (Shared): 60 s, then its 160 s cooldown." },
    { "console": "rbrage clear" },
    { "wait": 1 },
    { "give": { "item": "rebirthRageCapsuleOther", "count": 1 } },
    { "console": "rbrage other" },
    { "wait": 1 },
    { "expectBuff": "rebirthRageShared" },
    { "expectNoItem": "rebirthRageCapsuleOther" },

    { "_note": "Death Rage: a killing blow leaves the Berserker at 50 health with Death Rage and its protection." },
    { "console": "rbrage clear" },
    { "wait": 1 },
    { "damage": { "amount": 500, "type": "Bashing" } },
    { "wait": 1 },
    { "expectBuff": "rebirthRageDeath" },
    { "expectBuff": "rebirthRageDeathProtection" },
    { "expectStat": { "name": "health", "op": ">=", "value": 50 } },
    { "expectStat": { "name": "health", "op": "<", "value": 60 } },
    { "wait": 16 },
    { "expectBuff": "rebirthRageDeathCooldown" },

    { "_note": "Blood Moon Rage at Rage 80 starts by itself on a Blood Moon and ends with it. Kept short: the horde arrives within seconds." },
    { "console": "rbrage clear" },
    { "console": "rbtestgrant skill skill.rage 80" },
    { "console": "settime 7 22 0" },
    { "wait": 2 },
    { "expectBuff": "rebirthRageBloodMoon" },
    { "expectCvar": { "name": "$rbRageBloodRank", "op": "==", "value": 12 } },
    { "console": "settime 8 9 0" },
    { "wait": 2 },
    { "expectNoBuff": "rebirthRageBloodMoon" },
    { "cleararea": { "radius": 60 } },
    { "console": "rbrage clear" },
    { "expectNoErrors": true }
  ]
}
