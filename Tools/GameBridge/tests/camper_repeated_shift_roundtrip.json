{
  "name": "Repeated storage and station Shift-click round trips and close locks",
  "stopOnFailure": true,
  "steps": [
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 35,
        "checks": [
          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "storageCount",
            "op": "==",
            "value": 1
          },
          {
            "field": "stationCount",
            "op": "==",
            "value": 2
          },
          {
            "field": "capacity",
            "op": "==",
            "expectedField": "cargoSlots"
