{
  "name": "Progression routing: Character tab, N shortcut and Character Progression sidebar",
  "stopOnFailure": true,
  "steps": [
    {
      "_note": "Disposable ready REBIRTH character, windows closed, default Tab/N bindings. Current accepted top row has Character; Skills uses its Progression page, not a separate top-row Skills tab. Verify all three real-input routes, inspect screenshots. No remote/radial/reload acceptance implied."
    },
    {
      "action": {
        "command": "cleararea",
        "args": {
          "radius": 40
        }
      }
    },
    {
      "action": {
        "command": "restore",
        "args": {}
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Tab"
        }
      }
    },
    {
      "expectWindowOpen": "crafting"
    },
    {
      "action": {
        "command": "click",
        "args": {
          "text": "Character"
        }
      }
    },
    {
      "expectWindowOpen": "rebirthSurvivorCharacter"
    },
    {
      "screenshot": "progression_character_tab"
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "N"
        }
      }
    },
    {
      "expectWindowOpen": "rebirthSurvivorCharacter"
    },
    {
      "screenshot": "progression_skills_key"
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Tab"
        }
      }
    },
    {
      "action": {
        "command": "click",
        "args": {
          "id": "btnRebirthCraftingTabCharacter"
        }
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthSurvivorCharacter",
        "timeout": 5
      }
    },
    {
      "click": {
        "id": "btnSurvivorTabProgression",
        "window": "rebirthSurvivorCharacter"
      }
    },
    {
      "expectUi": {
        "id": "survivorProgressionPanel",
        "window": "rebirthSurvivorCharacter"
      }
    },
    {
      "expectWindowOpen": "rebirthSurvivorCharacter"
    },
    {
      "screenshot": "progression_skills_tab"
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "expectNoErrors": true
    }
  ]
}