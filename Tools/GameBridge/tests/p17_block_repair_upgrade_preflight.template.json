        "args": {
          "action": "Secondary",
          "seconds": "@A2_HOLD_SECONDS@"
        }
      }
    },
    {
      "wait": "@A2_SETTLE_SECONDS@"
    },
    {
      "expectItemDelta": {
        "name": "@A2_ITEM@",
        "op": "==",
        "value": "@A2_CARRIED_DELTA@"
      }
    },
    {
      "action": {
        "command": "blockdamage",
        "args": {
          "x": "@A2_X@",
          "y": "@A2_Y@",
          "z": "@A2_Z@"
        }
      }
    },
    {
