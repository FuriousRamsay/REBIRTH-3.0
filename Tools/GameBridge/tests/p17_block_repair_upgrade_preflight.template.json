{
  "name": "p17_block_repair_upgrade_preflight",
  "stopOnFailure": true,
  "steps": [
    {
      "_note": "Disposable Purge, no open modal, three exact reachable prepared blocks for this batch. Copy to temp and fill all @TOKENS@ from measured baseline. A1 and A2 are fully local native repair/upgrade. B is remote-shortfall repair or upgrade with all missing materials in one identified crate. Preserve actual reach, repair amount, upgrade threshold, tool slot, permissions and inventory state. Use a different material for local and remote controls if their local stock would overlap."
    },
    {
      "action": {
        "command": "select",
        "args": {
          "slot": "@A1_TOOL_SLOT@"
        }
      }
    },
    {
      "action": {
        "command": "lookat",
        "args": {
          "x": "@A1_X@",
          "y": "@A1_Y@",
          "z": "@A1_Z@",
          "block": 1
        }
      }
    },
    {
      "expectTarget": "@A1_TYPE@"
    },
    {
      "action": {
        "command": "blockdamage",
        "args": {
          "x": "@A1_X@",
          "y": "@A1_Y@",
          "z": "@A1_Z@"
        }
      }
    },
    {
      "markItem": "@A1_ITEM@"
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "Secondary",
          "seconds": "@A1_HOLD_SECONDS@"
        }
      }
    },
    {
      "wait": "@A1_SETTLE_SECONDS@"
    },
    {
      "expectItemDelta": {
        "name": "@A1_ITEM@",
        "op": "==",
        "value": "@A1_CARRIED_DELTA@"
      }
    },
    {
      "action": {
        "command": "blockdamage",
        "args": {
          "x": "@A1_X@",
          "y": "@A1_Y@",
          "z": "@A1_Z@"
        }
      }
    },
    {
      "expectTarget": "@A1_AFTER_TYPE@"
    },
    {
      "action": {
        "command": "select",
        "args": {
          "slot": "@A2_TOOL_SLOT@"
        }
      }
    },
    {
      "action": {
        "command": "lookat",
        "args": {
          "x": "@A2_X@",
          "y": "@A2_Y@",
          "z": "@A2_Z@",
          "block": 1
        }
      }
    },
    {
      "expectTarget": "@A2_TYPE@"
    },
    {
      "action": {
        "command": "blockdamage",
        "args": {
          "x": "@A2_X@",
          "y": "@A2_Y@",
          "z": "@A2_Z@"
        }
      }
    },
    {
      "markItem": "@A2_ITEM@"
    },
    {
      "action": {
