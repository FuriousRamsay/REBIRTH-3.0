{
  "name": "Prepare a real ready Baked Potato batch without taking it",
  "stopOnFailure": true,
  "preconditions": "Fresh disposable CodexTest clone of TestProfile4. The campfire at 14,45,995 has the baseline ready grilled-meat job, grill and fuel. A cooking pot is in the backpack. This creates an ordinary ready cooking row; it does not claim to create a saved prepared-output owner marker.",
  "steps": [
    { "walkto": { "x": 14.5, "z": 993.3, "radius": 0.7 } },
    { "activate": { "x": 14, "y": 45, "z": 995, "block": 1 } },
    { "expectWindowOpen": "workstation_campfire" },
    { "click": { "id": "rebirthCookingTake", "window": "workstation_campfire" } },
    { "wait": 0.5 },
    { "expectNoUi": { "text": "READY TO TAKE", "window": "workstation_campfire" } },
    { "drag": { "from.item": "toolCookingPot", "to.path": "workstation_campfire/rebirthCookingRoot/station/cookingTools/content/inventory/0" } },
    { "action": { "command": "give", "args": { "item": "foodCropPotato", "count": 1 } } },
    { "click": { "text": "Baked Potato", "window": "workstation_campfire" } },
    { "click": { "id": "pullIngredients", "window": "workstation_campfire" } },
    { "expectUi": { "item": "foodCropPotato", "window": "workstation_campfire" } },
    { "click": { "text": "COOK", "window": "workstation_campfire" } },
    { "waitForUi": { "text": "READY TO TAKE", "window": "workstation_campfire", "timeout": 120 } },
    { "screenshot": "native_cleanup_ready_cooking_seed" },
    { "expectNoErrors": true }
  ]
}
