{
  "name": "Packed storage return must not merge with ordinary containers",
  "stopOnFailure": true,
  "steps": [
    {
      "action": {
        "command": "camper",
        "args": {
          "entity": 718
        }
      }
    },
    {
      "action": {
        "command": "lookat",
        "args": {
          "entity": 718
        }
      }
    },
    {
      "action": {
        "command": "give",
        "args": {
          "item": "cntGunSafeOpenWhite",
          "count": 2
        }
      }
    },
    {
      "markItem": "cntGunSafeOpenWhite"
    },
    {
      "action": {
        "command": "press",
        "args": {
          "action": "permanent.Activate",
          "hold": 1
        }
      }
    },
    {
      "wait": 0.9
    },
    {
      "action": {
        "command": "hover",
        "args": {
          "x": 510,
          "y": 380
        }
      }
    },
    {
      "action": {
        "command": "release",
        "args": {
          "action": "permanent.Activate"
        }
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthCamperStorageManagement",
        "timeout": 8
      }
    },
    {
      "expectWindowOpen": "rebirthCamperStorageManagement"
    },
    {
      "action": {
        "command": "click",
        "args": {
          "item": "cntGunSafeOpenWhite",
          "shift": 1
        }
      }
    },
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 8,
        "checks": [
          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "storageCount",
            "op": "==",
            "value": 1
          }
        ]
      }
    },
    {
      "expectItemDelta": {
        "name": "cntGunSafeOpenWhite",
        "op": "==",
        "value": -1
      }
    },
    {
      "action": {
        "command": "click",
        "args": {
          "id": "camperModule0",
          "shift": 1
        }
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "expectCamper": {
        "entity": 718,
        "timeout": 8,
        "checks": [
          {
            "field": "pending",
            "op": "==",
            "value": false
          },
          {
            "field": "storageCount",
            "op": "==",
            "value": 0
          }
        ]
      }
    },
    {
      "expectItemDelta": {
        "name": "cntGunSafeOpenWhite",
        "op": "==",
        "value": 0
      }
    },
    {
      "expectItemStacks": {
        "name": "cntGunSafeOpenWhite",
        "counts": [
          1,
          1
        ]
      }
    }
  ]
}
