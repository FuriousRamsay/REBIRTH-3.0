{
  "name": "Open current camper station through native radial menu",
  "stopOnFailure": true,
  "preconditions": "CodexTest is in-game beside owned camper entity 192 with one installed campfire.",
  "steps": [
    { "waitForGuardIdle": 30 },
    { "action": { "command": "lookat", "args": { "entity": 192 } } },
    { "action": { "command": "press", "args": { "action": "permanent.Activate", "hold": 1 } } },
    { "wait": 0.9 },
    { "action": { "command": "hover", "args": { "x": 518, "y": 289 } } },
    { "action": { "command": "release", "args": { "action": "permanent.Activate" } } },
    { "waitForWindowOpen": { "timeout": 5, "window": "rebirthCamperUseStation" } },
    { "expectCamper": { "entity": 192, "checks": [ { "field": "stationCount", "value": 1, "op": "==" }, { "field": "capacity", "value": 44, "op": "==" } ] } }
  ]
}
