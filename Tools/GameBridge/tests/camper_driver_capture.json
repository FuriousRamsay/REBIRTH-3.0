  "steps": [
    { "console": "camperdiag" },
    { "screenshot": "camper_driver_initial" },
    { "action": { "command": "move", "args": { "forward": 1, "seconds": 3 } } },
    { "console": "camperdiag" },
    { "screenshot": "camper_driver_forward" },
    { "action": { "command": "move", "args": { "forward": 1, "strafe": 1, "seconds": 2 } } },
    { "console": "camperdiag" },
    { "screenshot": "camper_driver_turn" },
    { "action": { "command": "move", "args": { "forward": -1, "seconds": 3 } } },
    { "console": "camperdiag" },
    { "screenshot": "camper_driver_reverse" },
    { "wait": 3 },
    { "console": "camperdiag" },
    { "action": { "command": "key", "args": { "name": "E" } } },
