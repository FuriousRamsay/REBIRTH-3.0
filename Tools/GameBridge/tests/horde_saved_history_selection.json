      }
    },
    {
      "expectUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeRank1_0Count",
        "exactText": "1"
      }
    },
    {
      "expectUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeCardValue1",
        "exactText": "2"
      }
    },
    {
      "screenshot": "horde_saved_night21_pistol"
    },
    {
      "click": {
        "id": "hordeHistorySelect2"
      }
    },
    {
      "waitForUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeSelection",
        "text": "Night 7",
        "timeout": 12
      }
    },
    {
