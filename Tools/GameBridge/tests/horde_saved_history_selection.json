{
  "name": "Saved native nights select independently and return to lifetime",
  "stopOnFailure": true,
  "steps": [
    {
      "_note": "NOT RUN. Preserved disposable CodexTest with saved nights newest21,14,7;21 pistol kill1,7 Other kill1/death1; lifetime kills2. Requires corrected native OnPress handler build. Observation/navigation only; no spawning or kill replay. No UI initially; safe guard-enabled arrival. If newer nights exist update actual row identity before using; do not reset evidence."
    },
    {
      "action": {
        "command": "surroundings"
      }
    },
    {
      "waitForGuardIdle": {
        "timeout": 20
      }
    },
    {
      "key": {
        "name": "Tab"
      }
    },
    {
      "click": {
        "text": "CHARACTER"
      }
    },
    {
      "waitForWindowOpen": {
        "window": "rebirthSurvivorCharacter",
        "timeout": 12
      }
    },
    {
      "click": {
        "id": "btnSurvivorTabHordeNight"
      }
    },
    {
      "waitForUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeHistoryLabel0",
        "text": "Night 21",
        "timeout": 12
      }
    },
    {
      "click": {
        "id": "hordeHistorySelect0"
      }
    },
    {
      "waitForUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeSelection",
        "text": "Night 21",
        "timeout": 12
      }
    },
    {
      "expectUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeRank0_0Name",
        "exactText": "1. Pistols"
      }
    },
    {
      "expectUi": {
        "window": "rebirthSurvivorCharacter",
        "id": "hordeRank0_0Count",
