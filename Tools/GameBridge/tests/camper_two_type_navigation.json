{
  "name": "Campfire and Workbench overview and tab cycle",
  "stopOnFailure": true,
  "preconditions": "NOT RUN. Invoke ONLY through camper_two_station_observation.py run-navigation: start nearby camper718 with its UI closed and native lockOwner=-1. Requires disposable CodexTest, campfire0 and workbench1, exactly two distinct installations, stopped empty queues and empty cursor. Radial geometry matches existing camper_overview_visual at1280x720. Actual installation/tools/fuel/output prepared by parent using ordinary UI; no direct queue editing.",
  "steps": [
    {"waitForGuardIdle":30},
    {"action":{"command":"lookat","args":{"entity":718}}},
    {"action":{"command":"press","args":{"action":"permanent.Activate","hold":1}}},
    {"wait":0.9},
    {"action":{"command":"hover","args":{"x":575,"y":250}}},
    {"action":{"command":"release","args":{"action":"permanent.Activate"}}},
    {"waitForWindowOpen":{"window":"rebirthCamperUseStation","timeout":8}},
    {"expectWindowOpen": "rebirthCamperUseStation"},
    {"expectCamper": {"entity": 718, "checks": [{"field":"stationCount","op":"==","value":2},{"field":"pending","op":"==","value":false},{"field":"cursorEmpty","op":"==","value":true}]}},
    {"expectUi": {"id":"camperStationTab0"}},
    {"expectUi": {"id":"camperStationTab1"}},
    {"expectNoUi": {"id":"camperStationTab2"}},
    {"action": {"command":"click","args":{"id":"camperStationTab0"}}},
    {"waitForWindowOpen": {"window":"workstation_campfire","timeout":10}},
    {"screenshot":"two_type_campfire_first"},
    {"action": {"command":"click","args":{"id":"camperStationTab1"}}},
    {"waitForWindowOpen": {"window":"workstation_workbench","timeout":10}},
    {"screenshot":"two_type_workbench_first"},
    {"action": {"command":"click","args":{"id":"camperSwitchStationButton"}}},
    {"waitForWindowOpen": {"window":"rebirthCamperUseStation","timeout":10}},
    {"action": {"command":"click","args":{"id":"camperStationTab1"}}},
    {"waitForWindowOpen": {"window":"workstation_workbench","timeout":10}},
    {"action": {"command":"click","args":{"id":"camperStationTab0"}}},
    {"waitForWindowOpen": {"window":"workstation_campfire","timeout":10}},
    {"action": {"command":"click","args":{"id":"camperSwitchStationButton"}}},
    {"waitForWindowOpen": {"window":"rebirthCamperUseStation","timeout":10}},
    {"screenshot":"two_type_overview_return"},
    {"action": {"command":"click","args":{"id":"camperStationPickerClose"}}},
    {"expectCamper": {"entity":718,"timeout":35,"checks":[{"field":"pending","op":"==","value":false},{"field":"lockOwner","op":"==","value":-1},{"field":"cursorEmpty","op":"==","value":true}]}},
    {"expectNoErrors":true}
  ]
