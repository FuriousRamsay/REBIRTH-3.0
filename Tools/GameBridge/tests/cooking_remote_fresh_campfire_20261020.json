{
  "name": "Dedicated remote client fresh campfire Pull Cook Take",
  "stopOnFailure": true,
  "preconditions": "Disposable Navezgane/CodexTest dedicated server and remote client on the same current DLL. Client is spawned at (-273,61,448) with no console or other window open; placed campfire at (-272,61,451) is empty. This scenario supplies items to the loaded test save; do not restart for missing inventory. Record both peers' topology and server queue before and after; reconnect to verify no duplicate Take.",
  "steps": [
    { "action": { "command": "cleararea", "args": { "radius": 40 } } },
    { "action": { "command": "restore", "args": {} } },
    { "action": { "command": "give", "args": { "item": "toolCookingPot", "count": 1 } } },
    { "action": { "command": "give", "args": { "item": "resourceWood", "count": 30 } } },
    { "action": { "command": "give", "args": { "item": "foodCropPotato", "count": 2 } } },
    { "activate": { "x": -272, "y": 61, "z": 451, "block": 1 } },
    { "waitForWindowOpen": { "window": "workstation_campfire", "timeout": 10 } },
    { "expectWindowOpen": "workstation_campfire" },
    { "expectStation": { "x": -272, "y": 61, "z": 451, "station": "campfire", "field": "queueCount", "op": "==", "value": 0, "allowOpen": true } },
    { "click": { "item": "toolCookingPot", "shift": 1, "window": "workstation_campfire" } },
    { "click": { "item": "resourceWood", "shift": 1, "window": "workstation_campfire" } },
    { "click": { "text": "Turn On", "window": "workstation_campfire" } },
    { "click": { "text": "Baked Potato", "window": "workstation_campfire" } },
    { "markItem": "foodCropPotato" },
    { "click": { "id": "pullIngredients", "window": "workstation_campfire" } },
    { "expectItemDelta": { "name": "foodCropPotato", "op": "==", "value": -1 } },
    { "expectUi": { "item": "foodCropPotato", "window": "workstation_campfire" } },
    { "screenshot": "remote_cooking_recipe_and_inventory" },
    { "markItem": "foodBakedPotato" },
    { "click": { "text": "COOK", "window": "workstation_campfire" } },
    { "waitForUi": { "text": "READY TO TAKE", "window": "workstation_campfire", "timeout": 120 } },
    { "screenshot": "remote_cooking_ready_text_and_timer" },
    { "click": { "id": "rebirthCookingTake", "window": "workstation_campfire" } },
    { "expectItemDelta": { "name": "foodBakedPotato", "op": "==", "value": 1 } },
    { "screenshot": "remote_cooking_after_take" },
    { "key": { "name": "Escape" } },
    { "expectStation": { "x": -272, "y": 61, "z": 451, "station": "campfire", "field": "queueCount", "op": "==", "value": 0 } },
    { "expectNoErrors": true }
  ]
}
