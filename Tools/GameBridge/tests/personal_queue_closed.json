{
  "name": "Personal queue completes two jobs with backpack closed",
  "stopOnFailure": true,
  "steps": [
    {
      "action": {
        "command": "cleararea",
        "args": {
          "radius": 40
        }
      }
    },
    {
      "action": {
        "command": "restore"
      }
    },
    {
      "action": {
        "command": "give",
        "args": {
          "item": "resourceCloth",
          "count": 12
        }
      }
    },
    {
      "action": {
        "command": "give",
        "args": {
          "item": "resourceScrapIron",
          "count": 4
        }
      }
    },
    {
      "markItem": "resourceCloth"
    },
    {
      "markItem": "resourceScrapIron"
    },
    {
      "markItem": "rebirthGearUtilityBelt"
    },
    {
      "ui": {
        "action": "open",
        "window": "crafting"
      }
    },
    {
      "action": {
        "command": "type",
        "args": {
          "id": "rebirthCraftingRecipeSearch",
          "value": "utility"
        }
      }
    },
    {
      "wait": 0.5
    },
    {
      "action": {
        "command": "click",
        "args": {
          "recipe": "rebirthGearUtilityBelt"
        }
      }
    },
    {
      "screenshot": "starter_belt_recipe"
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "W"
        }
      }
    },
    {
      "wait": 0.3
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "W"
        }
      }
    },
    {
      "action": {
        "command": "key",
        "args": {
          "name": "Escape"
        }
      }
    },
    {
      "wait": 24
    },
    {
      "expectItemDelta": {
        "name": "resourceCloth",
        "op": "==",
        "value": -12
      }
    },
    {
      "expectItemDelta": {
        "name": "resourceScrapIron",
        "op": "==",
        "value": -4
      }
    },
    {
      "expectItemDelta": {
        "name": "rebirthGearUtilityBelt",
        "op": "==",
        "value": 2
      }
    },
    {
      "expectNoErrors": true
    }
  ]
}