<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName Condition="'$(EntityStudioGameAdapter)' == 'true'">RebirthEntityStudio</AssemblyName>
    <ModRoot>$(MSBuildThisFileDirectory)..\..\..</ModRoot>
    <ManagedRoot>$(ModRoot)\..\..\7DaysToDie_Data\Managed</ManagedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ModRoot)\Scripts\Entities\Studio\RebirthEntityStudioRuntime.cs" />
    <Compile Include="$(ModRoot)\Scripts\Entities\Studio\RebirthEntityStudioMaterials.cs" />
    <Compile Include="$(ModRoot)\Scripts\Entities\Studio\RebirthEntityStudioBridge.cs" />
    <Compile Include="$(ModRoot)\Scripts\GameBridge\RebirthGameBridgeEntityModelInspection.cs" Condition="'$(EntityStudioGameAdapter)' != 'true'" />
    <Reference Include="RebirthUtils"><HintPath>$(ModRoot)\RebirthUtils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ModRoot)\..\0_TFP_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedRoot)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedRoot)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedRoot)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(ManagedRoot)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedRoot)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary"><HintPath>$(ManagedRoot)\LogLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedRoot)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedRoot)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedRoot)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedRoot)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
