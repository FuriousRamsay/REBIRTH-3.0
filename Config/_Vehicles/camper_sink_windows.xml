<configs>
  <append xpath="/windows/window[@name='windowToolbelt']">
    <rect name="rebirthCamperSinkHud" controller="RebirthCamperSinkHud, RebirthUtils" always_update="true" pos="440,166" width="360" height="44" depth="30">
      <rect name="camperSinkCard" width="360" height="44" visible="false">
        <sprite name="camperSinkBackground" depth="1" sprite="menu_empty" width="360" height="44" color="18,18,22,240" />
        <sprite name="camperSinkFrame" depth="2" sprite="menu_empty2px" type="sliced" fillcenter="false" width="360" height="44" color="112,112,112,230" />
        <label name="camperSinkCaption" depth="4" pos="10,-4" width="340" height="20" text="{campersinkcaption}" font_size="18" justify="center" color="245,245,245,255" overflow="shrinkcontent" />
        <sprite name="camperSinkTrack" depth="2" pos="10,-29" width="340" height="8" sprite="menu_empty" color="96,96,96,255" />
        <sprite name="camperSinkFill" depth="3" pos="10,-29" width="340" height="8" sprite="menu_empty" type="filled" filldirection="Horizontal" fill="{campersinkfill}" color="86,158,220,255" />
      </rect>
    </rect>
  </append>
</configs>
