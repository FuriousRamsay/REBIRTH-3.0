	</append>
	
	<append xpath="/items/item[starts-with(@name,'part') or
								@name='smallEngine' or
								@name='resourceHeadlight' or
								@name='carBattery'
								]">
		<effect_group name="Economic Value">
			<passive_effect name="EconomicValue" operation="perc_add" value="0,.6,1.2,1.8,2.4,3.2" tier="1,2,3,4,5,6"/>
		</effect_group>
	</append>
	
	<!-- Vehicle restoration parts must retain their quality overlay in every standard item-stack location. -->
	<append xpath="/items/item[(@name='smallEngine' or starts-with(@name,'part')) and not(property[@name='ShowQuality'])]">
		<property name="ShowQuality" value="true"/>
	</append>

