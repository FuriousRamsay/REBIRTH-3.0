	<!-- Native 2.6-style vehicle respawn lifecycle. -->
	<append xpath="/blocks">
		<block name="carRespawner_FR">
			<property name="CreativeMode" value="None"/>
			<property name="Class" value="BlockRespawnRebirth, RebirthUtils"/>
			<property name="Material" value="Mair"/>
			<property name="Shape" value="Invisible"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Collide" value="melee"/>
			<property name="CanMobsSpawnOn" value="false"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<drop event="Destroy" count="0"/>
			<property class="PlantGrowing">
				<property name="Next" value="carsRandomHelper"/>
				<property name="GrowthRate" value="0.01"/>
				<property name="FertileLevel" value="0"/>
				<property name="LightLevelStay" value="0"/>
				<property name="LightLevelGrow" value="0"/>
				<property name="GrowIfAnythinOnTop" value="true"/>
				<property name="IsRandom" value="false"/>
			</property>
		</block>
	</append>

	<!-- Exact base-game vehicle roots used by the working 2.6 feature. Runtime binding covers concrete placeholder outputs. -->
	<append xpath="/blocks/block[@name='cntArmyTruckOpen' or @name='cntArmyTruckClosed']">
		<property name="DowngradeBlock" value="carRespawner_FR"/>
	</append>
