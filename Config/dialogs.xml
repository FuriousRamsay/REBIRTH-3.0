  <!-- REBIRTH 2.6 dog dialog contract. GuardHere remains implemented but intentionally omitted from the dog start statement, matching production 2.6. -->
  <append xpath="/dialogs">
    <dialog id="FuriousRamsayCompanion" startstatementid="start">
      <statement id="start" text="dialog_trader_statement_start">
        <response_entry id="FollowMe"/><response_entry id="StayHere"/><response_entry id="Respawn"/><response_entry id="PickUp"/><response_entry id="ShowMe"/><response_entry id="Remove"/><response_entry id="ChangeName"/><response_entry id="StatsCompanion"/>
      </statement>
      <response id="StatsCompanion" text="rebirth_dialog_StatsCompanion"><action type="DialogActionRebirthDog, RebirthUtils" id="Stats"/></response>
      <response id="Respawn" text="Report for Duty"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="AwaitingRespawn"/><action type="DialogActionRebirthDog, RebirthUtils" id="ReportForDuty"/></response>
      <response id="PickUp" text="Come with me"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="Active"/><requirement type="DialogRequirementRebirthDogPickupReady, RebirthUtils" requirementtype="Hide"/><action type="DialogActionRebirthDog, RebirthUtils" id="Pickup"/></response>
      <response id="ChangeName" text="Change My Name"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="Active"/><action type="DialogActionRebirthDog, RebirthUtils" id="Rename"/></response>
      <response id="FollowMe" text="Follow me"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="Active"/><requirement type="DialogRequirementRebirthDogOrderNot, RebirthUtils" requirementtype="Hide" value="Follow"/><action type="DialogActionRebirthDog, RebirthUtils" id="Follow"/></response>
      <response id="StayHere" text="Stay where you are"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogOrderNot, RebirthUtils" requirementtype="Hide" value="Stay"/><action type="DialogActionRebirthDog, RebirthUtils" id="Stay"/></response>
      <response id="GuardHere" text="Stay where I am"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="Active"/><action type="DialogActionRebirthDog, RebirthUtils" id="Guard"/></response>
      <response id="ShowMe" text="rebirth_dialog_ShowMe" ref_text="Show Me your inventory"><requirement type="DialogRequirementRebirthDogOwner, RebirthUtils" requirementtype="Hide"/><requirement type="DialogRequirementRebirthDogLifecycle, RebirthUtils" requirementtype="Hide" value="Active"/><requirement type="DialogRequirementRebirthDogInventoryEnabled, RebirthUtils" requirementtype="Hide"/><action type="DialogActionRebirthDog, RebirthUtils" id="Inventory"/></response>
      <response id="Remove" text="Remove Me (Admin)"><requirement type="DialogRequirementRebirthDogAdmin, RebirthUtils" requirementtype="Hide"/><action type="DialogActionRebirthDog, RebirthUtils" id="AdminRemove"/></response>
    </dialog>
  </append>
</configs>
