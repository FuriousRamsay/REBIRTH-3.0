<configs>
  <conditional><if cond="character_progression('Rebirth')">
    <remove xpath="/dialogs/dialog[@id='trader']/response[starts-with(@id,'jobshave')]/requirement[@type='CheckCVar' and @id='IntroComplete']"/>
  </if></conditional>
  <!-- v93: 2.6 parity. Do not show vanilla "jobsnone" as a fallback when
       REBIRTH capacity hides every jobshaveN response. -->
  <remove xpath="/dialogs/dialog[@id='trader']/response[@id='jobsnone']"/>

  <!-- Restore the 2.6 REBIRTH multi-job availability rule. Vanilla 3.1
       QuestStatus/NotStarted hides Jobs after one active quest from the trader. -->
  <setattribute xpath="/dialogs/dialog[@id='trader']/response[starts-with(@id, 'jobshave')]/requirement[@type='QuestStatus']" name="type">QuestStatusRebirth, RebirthUtils</setattribute>
  <!-- Restore the 2.6 REBIRTH trader job-list capacity on the 3.1 tiered dialog. -->
  <insertAfter xpath="/dialogs/dialog[@id='trader']/statement[@id='currentjobs1']/quest_entry[@listindex='6']">
    <quest_entry listindex="7" tier="1" />
    <quest_entry listindex="8" tier="1" />
