<configs>
  <!-- 2.6 Mind Control Brew and Potion. Turning undead goes through the Black Magic service, as the arrows do. -->
  <append xpath="/items">
    <item name="FuriousRamsayMindControlDrink">
      <property name="Tags" value="drink" />
      <property name="CustomIcon" value="drinkJarMindControl" />
      <property name="HoldType" value="3" />
      <property name="Meshfile" value="@:Other/Items/Food/masonJarWaterPrefab.prefab" />
      <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
      <property name="Material" value="Mglass" />
      <property name="Stacknumber" value="100" />
      <property name="Weight" value="10" />
      <property name="EconomicValue" value="68" />
      <property name="Group" value="Food/Cooking,CFDrink/Cooking" />
      <property class="Action0">
        <property name="Class" value="Eat" />
        <property name="Delay" value="1.0" />
        <property name="Use_time" value="..." />
        <property name="Sound_start" value="player_drinking" />
        <property name="Create_item" value="drinkJarEmpty" />
      </property>
      <effect_group tiered="false" name="Drink">
        <display_value name="dDuration" value="300" />
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyStats" stat="water" operation="add" value="-15" />
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffExtinguishFire">
          <requirement name="HasBuff" buff="buffIsOnFire" />
        </triggered_effect>
        <triggered_effect trigger="onSelfPrimaryActionStart" action="RemoveBuff" buff="FuriousRamsaySetMindControl">
          <requirement name="RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="FuriousRamsaySetMindControl">
          <requirement name="RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffDysenteryCatchDrink">
          <requirement name="!RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
      </effect_group>
    </item>
    <item name="FuriousRamsayMindControlPotion">
      <property name="Class" value="ItemClassTimeBomb" />
      <property name="Tags" value="drink" />
      <property name="CustomIcon" value="FuriousRamsayPotionSmallPurple_icon" />
      <property name="HoldType" value="54" />
      <property name="Meshfile" value="#@modfolder:Resources/FR_Potions.unity3d?TestTubeSmallPurple_FR" />
      <property name="DropMeshfile" value="#@modfolder:Resources/FR_Potions.unity3d?TestTubeSmallPurple_FR" />
      <property name="HandMeshfile" value="#@modfolder:Resources/FR_Potions.unity3d?TestTubeSmallPurple_FR" />
      <property name="Material" value="Mglass" />
      <property name="Stacknumber" value="100" />
      <property name="Weight" value="10" />
      <property name="EconomicValue" value="68" />
      <property name="Group" value="Food/Cooking,CFDrink/Cooking" />
      <property name="FuseTime" value="20000" />
      <property name="ExplodeOnHit" value="true" />
      <property class="Explosion">
        <property name="ParticleIndex" value="0" />
        <property name="RadiusBlocks" value="0" />
        <property name="RadiusEntities" value="0" />
        <property name="BlastPower" value="0" />
        <property name="BlockDamage" value="0" />
        <property name="EntityDamage" value="0" />
      </property>
      <property class="Action0">
        <property name="Class" value="ThrowAway" />
        <property name="Delay" value="1.2" />
        <property name="Throw_strength_default" value="20" />
        <property name="Throw_strength_max" value="50" />
        <property name="Sound_start" value="swoosh" />
        <requirement name="RebirthIsWitchDoctor, RebirthUtils" />
      </property>
      <property class="Action1">
        <property name="Class" value="Eat" />
        <property name="Delay" value="1.0" />
        <property name="Use_time" value="..." />
        <property name="Sound_start" value="player_drinking" />
        <property name="Create_item" value="drinkJarEmpty" />
      </property>
      <effect_group tiered="false" name="Thrown">
        <triggered_effect trigger="onProjectileImpact" action="RebirthMindControlArea, RebirthUtils" radius="3" />
        <triggered_effect trigger="onProjectileImpact" action="ModifyStats" target="self" stat="Health" operation="add" value="-1" />
      </effect_group>
      <effect_group tiered="false" name="Drink">
        <display_value name="dDuration" value="300" />
        <triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyStats" stat="water" operation="add" value="-15" />
        <triggered_effect trigger="onSelfSecondaryActionStart" action="RemoveBuff" buff="FuriousRamsaySetMindControl">
          <requirement name="RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
        <triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="FuriousRamsaySetMindControl">
          <requirement name="RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
        <triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffDysenteryCatchDrink">
          <requirement name="!RebirthIsWitchDoctor, RebirthUtils" />
        </triggered_effect>
      </effect_group>
    </item>
  </append>

  <!-- 2.6: while the brew is active, scythe power attacks turn nearby undead at a cost of 1 health per hit. -->
  <append xpath="/items/item[property[@name='Tags' and contains(@value,'scythe')]]">
    <effect_group tiered="false" name="Mind Control Brew">
      <triggered_effect trigger="onSelfSecondaryActionRayHit" action="RebirthMindControlHit, RebirthUtils" target="selfAOE" range="2">
        <requirement name="CVarCompare" cvar="$varFuriousRamsayMindControlActive" operation="Equals" value="1" />
      </triggered_effect>
      <triggered_effect trigger="onSelfSecondaryActionRayHit" action="ModifyStats" stat="Health" operation="add" value="-1">
        <requirement name="CVarCompare" cvar="$varFuriousRamsayMindControlActive" operation="Equals" value="1" />
        <requirement name="EntityTagCompare" target="other" tags="zombie" />
        <requirement name="!EntityTagCompare" target="other" tags="boss" />
      </triggered_effect>
    </effect_group>
  </append>
</configs>
