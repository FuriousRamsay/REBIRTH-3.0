<configs>
  <append xpath="/blocks">
    <block name="FuriousRamsayAmmoMachine">
			<property name="Class" value="Workstation"/>
			<property name="CustomIcon" value="FuriousRamsayAmmoMachine"/>
			<property name="UnlockedBy" value="FuriousRamsaySchematicAmmoMachine"/>
			<property name="Path" value="solid"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/FR_Industrial.unity3d?FuriousRamsayAmmoMachine_FR" />
			<property name="Material" value="MmetalPickUp"/>
			<property name="MaxDamage" value="2000" />
			<property name="StabilitySupport" value="true" />
			<property name="Path" value="solid" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="OnlySimpleRotations" value="true" />
			<property name="IsTerrainDecoration" value="true" />
			<property name="HasAnim" value="skipBurningSound"/>
			<property name="ImposterDontBlock" value="true" />
			<property name="Stacknumber" value="1" />
			<property name="HeatMapStrength" value="6" />
			<property name="HeatMapTime" value="5000" />
			<property name="HeatMapFrequency" value="1000" />

			<property name="MultiBlockDim" value="6,3,2"/>
			<property name="ModelOffset" value="0,1.2,0"/>

			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="FuriousRamsayAmmoMachine" />
				<property name="Modules" value="output,fuel" />
			</property>
			<property name="FuelType" value="ammoGasCan"/>
			<property name="WorkstationIcon" value="ui_game_symbol_FuriousRamsayAmmoMachine" />
			<property name="OpenSound" value="FuriousRamsayAmmoMachineOpen"/>
			<property name="CloseSound" value=""/>
			<property name="CraftSound" value="FuriousRamsayAmmoMachineOpen" />
			<property name="CraftCompleteSound" value=""/>

			<property name="TakeDelay" value="2.5" />
			<property name="Group" value="Building"/>
			<property name="EconomicValue" value="1000" />
			<property name="SellableToTrader" value="false"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor" />
			<property name="SortOrder1" value="70i0" />

			<drop event="Harvest" name="" count="0" tool_category="Disassemble"/>
			<drop event="Destroy" name="FuriousRamsayAmmoMachine" count="1" tool_category="Disassemble"/>
			<drop event="Fall" name="FuriousRamsayAmmoMachine" count="1" prob="1" stick_chance="1"/>
			<property class="RepairItems">
				<property name="resourceScrapIron" value="10" />
			</property>
		</block>
    <block name="AlchemyTable001_FR">
			<property name="CustomIcon" value="FuriousRamsayAlchemyTable_icon"/>
			<property name="MultiBlockDim" value="2,2,1"/>
			<property name="ModelOffset" value="0,-.25,0"/>
			<property name="Path" value="solid"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/FR_Alchemy.unity3d?AlchemyTable001_FR" />
			<property name="Class" value="Workstation"/>
			<property name="Material" value="MwoodPickUp"/>
			<property name="MaxDamage" value="300"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="Stacknumber" value="1"/>
			<property name="CraftActionName" value="Start" />
			<property name="CraftIcon" value="ui_game_symbol_check" />
			<property class="Workstation">
				<property name="Modules" value="tools,output"/>
				<property name="CraftingAreaRecipes" value="AlchemyTable001_FR"/>
			</property>
			<property name="WorkstationIcon" value="ui_game_symbol_FuriousRamsayAlchemyTable_icon"/>

			<property name="OpenSound" value="FuriousRamsayAlchemyTableOpen"/>
			<property name="CloseSound" value=""/>
			<property name="CraftSound" value="FuriousRamsayAlchemyCraft" />
			<property name="CraftCompleteSound" value=""/>
			<property name="TakeDelay" value="2.5" />
			<property class="RepairItems">
				<property name="resourceScrapIron" value="10"/>
			</property>
			<drop event="Harvest" name="" count="0" tool_category="Disassemble" />
			<drop event="Destroy" name="AlchemyTable001_FR" count="1" tool_category="Disassemble" />
			<drop event="Fall" name="AlchemyTable001_FR" count="1" prob="1" stick_chance="1"/>
			<property name="EconomicValue" value="2000"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
			<property name="SortOrder1" value="70i0"/>
			<property name="SellableToTrader" value="false"/>
		</block>
  </append>
  <!-- 2.6 scrap tool wear per minute, and the Shredder dropping itself when it falls. -->
  <append xpath="/blocks/block[@name='WorkbenchShredder001_FR']"><property name="ScrapToolWearPerMinute" value="50" /></append>
  <append xpath="/blocks/block[@name='SonjaAmmoRecyclerStation']"><property name="ScrapToolWearPerMinute" value="500" /></append>
  <setattribute xpath="/blocks/block[@name='WorkbenchShredder001_FR']/drop[@event='Fall']" name="name">WorkbenchShredder001_FR</setattribute>
  <setattribute xpath="/blocks/block[@name='WorkbenchShredder001_FR']/drop[@event='Fall']" name="count">1</setattribute>
</configs>
