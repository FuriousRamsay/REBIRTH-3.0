<configs>

	<!-- REBIRTH Fire module entry point. -->
	<include filename="_Fire/items.xml"/>
	  <conditional>
    <if cond="character_progression('Rebirth')">
      <include filename="_Rebirth/items_starter.xml"/>
    </if>
    <else>
      <include filename="_Base/items_starter.xml"/>
    </else>
  </conditional>
  <!-- Advanced Farming water exchange: preserve vanilla natural-water CollectWater/DumpWater behavior while adding focused tank/collector support. -->
  <set xpath="/items/item[@name='bucketEmpty']/property[@class='Action1']/property[@name='Class']/@value">CollectWaterRebirth, RebirthUtils</set>
  <set xpath="/items/item[@name='bucketRiverWater']/property[@class='Action1']/property[@name='Class']/@value">DumpWaterRebirth, RebirthUtils</set>
  <set xpath="/items/item[@name='drinkJarEmpty']/property[@class='Action1']/property[@name='Class']/@value">CollectWaterRebirth, RebirthUtils</set>

  <!-- Filled jars did not have an Action1 exchange path in 3.0, so they could not fill Advanced Farming water storage. This focused action only works on tanks/collectors and does not affect normal drinking. -->
  <append xpath="/items/item[@name='drinkJarRiverWater']">
    <property class="Action1">
      <property name="Class" value="ExchangeItemRebirth, RebirthUtils" />
      <property name="Delay" value="0.5" />
      <property name="Change_item_to" value="drinkJarEmpty" />
      <property name="Sound_start" value="bucketplace_water" />
    </property>
  </append>
  <append xpath="/items/item[@name='drinkJarBoiledWater']">
    <property class="Action1">
      <property name="Class" value="ExchangeItemRebirth, RebirthUtils" />
      <property name="Delay" value="0.5" />
      <property name="Change_item_to" value="drinkJarEmpty" />
      <property name="Sound_start" value="bucketplace_water" />
    </property>
  </append>
  <append xpath="/items/item[@name='drinkJarPureMineralWater']">
    <property class="Action1">
      <property name="Class" value="ExchangeItemRebirth, RebirthUtils" />
      <property name="Delay" value="0.5" />
      <property name="Change_item_to" value="drinkJarEmpty" />
      <property name="Sound_start" value="bucketplace_water" />
    </property>
  </append>

  <!-- Restrictive Healing / Prevent Healing Overlap: all direct medical-item use enters one shared policy before vanilla consumption/effects. -->
  <set xpath="/items/item[@name='medicalBandage']/property[@class='Action0']/property[@name='Class']/@value">ItemActionUseMedRebirthBleeding, RebirthUtils</set>
  <set xpath="/items/item[@name='medicalAloeCream']/property[@class='Action0']/property[@name='Class']/@value">ItemActionUseMedRebirth, RebirthUtils</set>


  <!-- REBIRTH 2.6 mutated-spit restoration. The action is server-authoritative and performs the original 1-in-6 spawn roll with a 12-minion / 40-metre cap. -->
  <append xpath="/items/item[@name='ammoProjectileZombieMutated']">
    <effect_group name="REBIRTH Mutated Spit Spawn" tiered="false">
      <triggered_effect trigger="onProjectileImpact" action="RebirthMutatedSpitImpact, RebirthUtils" />
    </effect_group>
  </append>

  <!-- Minion melee item restored from the 2.6 definition. -->
  <append xpath="/items">
    <item name="FuriousRamsayMeleeHandzombieMutatedMinion">
      <property name="Extends" value="meleeHandMaster" />
      <property name="CreativeMode" value="None" />
      <property name="Degradation" value="99999" param1="true" />
      <property class="Action0">
        <property name="Range" value="1.3" />
        <property name="DamageEntity" value="15" />
        <property name="DamageBlock" value="100" />
      </property>
      <effect_group name="melee" tiered="false">
        <passive_effect name="ModSlots" operation="base_set" value="0" />
        <triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" fireOneBuff="true" buff="buffFatiguedTrigger,buffArmSprainedCHTrigger,buffLegSprainedCHTrigger,buffLaceration,buffAbrasionCatch,buffInjuryStunned01CHTrigger,buffInjuryBleedingTwo" weights=".11,.07,.07,.05,.29,.36,.11" />
        <triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="infectionCounter" operation="add" value="10">
          <requirement name="CVarCompare" target="other" cvar="infectionCounter" operation="GT" value="0" />
        </triggered_effect>
        <triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="abrasionZombieHit" operation="set" value="1800" />
      </effect_group>
    </item>
  </append>

	<include filename="_Farming/items.xml"/>


	<include filename="_Vehicles/items.xml"/>


  <!-- REBIRTH 2.6 Hive dog-token prerequisite. The eight restored Hive dog recipes consume this item. -->
  <append xpath="/items">
    <item name="BlueDog3">
      <property name="CustomIcon" value="BlueDog3"/>
      <property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
      <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
      <property name="HoldingItemHidden" value="true"/>
      <property name="Stacknumber" value="500"/>
      <property name="Material" value="Morganic"/>
      <property name="HoldType" value="45"/>
      <property name="Weight" value="0"/>
      <property name="Candrop" value="true"/>
    </item>
  </append>

  <!-- REBIRTH dog companion: exact 2.6 dedicated melee hand. -->
  <append xpath="/items">
    <item name="FuriousRamsayMeleeHandDog">
      <property name="Extends" value="meleeHandAnimalWolf"/>
      <property name="CreativeMode" value="None"/>
      <property name="HoldType" value="35"/>
      <property class="Action0">
        <property name="Sphere" value="1"/>
        <property name="Delay" value="2"/>
        <property name="Range" value="2"/>
        <property name="DamageEntity" value="30"/>
        <property name="DamageBlock" value="60"/>
      </property>
    </item>
  </append>

	<include filename="_Metabolism/items.xml"/>
	  <conditional>
    <if cond="character_progression('Rebirth')">
      <include filename="_Rebirth/items.xml"/>
      <include filename="_Cooking/balance_items.xml"/>
      <include filename="_Cooking/burnt_items.xml"/>
    </if>
    <else>
      <include filename="_Base/items.xml"/>
    </else>
  </conditional>
  <!-- Fix34: identical liquid containers stack to ten. Run after every included item file. -->
  <set xpath="/items/item[property[@name='RebirthMetabolismType' and @value='Drink']]/property[@name='Stacknumber']/@value">10</set>
  <conditional><if cond="xpath('/items/item[property[@name=&quot;RebirthMetabolismType&quot; and @value=&quot;Drink&quot;] and not(property[@name=&quot;Stacknumber&quot;])]') != null"><append xpath="/items/item[property[@name='RebirthMetabolismType' and @value='Drink'] and not(property[@name='Stacknumber'])]">
    <property name="Stacknumber" value="10" />
  </append></if></conditional>
  <!-- Readable study media use the native held book rather than resourcePaper's sack. -->
  <remove xpath="/items/item[property[@class='Action0']/property[@name='Class' and @value='ItemActionStudyLiteratureRebirth, RebirthUtils']]/property[@name='Meshfile' or @name='HoldType']" />
  <append xpath="/items/item[property[@class='Action0']/property[@name='Class' and @value='ItemActionStudyLiteratureRebirth, RebirthUtils']]">
    <property name="Meshfile" value="@:Other/Items/Misc/bookPrefab.prefab" />
    <property name="HoldType" value="21" />
  </append>
</configs>
