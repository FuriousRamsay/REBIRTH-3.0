<configs>
    <!-- The three clips are stored in Resources/RB_TOOL_FireEXT.unity3d. -->
    <append xpath="/Sounds">
        <SoundDataNode name="FireEXT_fire">
            <AudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire.prefab"/>
            <NetworkAudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire_Network.prefab"/>
            <Noise ID="0" noise="2" time="2" muffled_when_crouched="0.8" heat_map_strength="0.9" heat_map_time="180"/>
            <AudioClip ClipName="#@modfolder(zzz_REBIRTH__3_0):Resources/RB_TOOL_FireEXT.unity3d?Fire_EX_fire"/>
            <LocalCrouchVolumeScale value="1"/>
            <CrouchNoiseScale value="1"/>
            <NoiseScale value="1"/>
            <MaxVoices value="40"/>
            <MaxVoicesPerEntity value="30"/>
            <MaxRepeatRate value="0.001"/>
        </SoundDataNode>

        <SoundDataNode name="FireEXT_loop">
            <AudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire.prefab"/>
            <NetworkAudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire_Network.prefab"/>
            <Noise ID="0" noise="2" time="2" muffled_when_crouched="0.8" heat_map_strength="0.9" heat_map_time="180"/>
            <AudioClip ClipName="#@modfolder(zzz_REBIRTH__3_0):Resources/RB_TOOL_FireEXT.unity3d?Fire_EX_loop"/>
            <LocalCrouchVolumeScale value="1"/>
            <CrouchNoiseScale value="1"/>
            <NoiseScale value="1"/>
            <MaxVoices value="40"/>
            <MaxVoicesPerEntity value="30"/>
            <MaxRepeatRate value="0.001"/>
        </SoundDataNode>

        <SoundDataNode name="FireEXT_end">
            <AudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire.prefab"/>
            <NetworkAudioSource name="@:Sounds/Prefabs/AudioSource_WeaponFire_Network.prefab"/>
            <Noise ID="0" noise="2" time="2" muffled_when_crouched="0.8" heat_map_strength="0.9" heat_map_time="180"/>
            <AudioClip ClipName="#@modfolder(zzz_REBIRTH__3_0):Resources/RB_TOOL_FireEXT.unity3d?Fire_EX_end"/>
            <LocalCrouchVolumeScale value="1"/>
            <CrouchNoiseScale value="1"/>
            <NoiseScale value="1"/>
            <MaxVoices value="40"/>
            <MaxVoicesPerEntity value="30"/>
            <MaxRepeatRate value="0.001"/>
        </SoundDataNode>
    </append>
</configs>
