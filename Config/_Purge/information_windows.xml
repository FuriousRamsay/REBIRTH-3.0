          <label name="purgeInformationBody" width="950" height="365" font_size="26" color="[white]" overflow="resizeheight" support_bb_code="true"/>
        </scrollview>
      </rect>
      <button name="purgeInformationClose" pos="380,-720" width="260" height="42" sprite="menu_empty2px" type="sliced" defaultcolor="140,123,91,255" hovercolor="180,160,120,255" depth="12" hoverscale="1.0">
        <label depth="14" pos="0,0" width="260" height="42" font_size="24" justify="center" text_key="xuiClose" color="[white]"/>
      </button>
    </window>
  </append>
</configs>