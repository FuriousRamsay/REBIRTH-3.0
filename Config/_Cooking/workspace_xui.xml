<configs>
  <append xpath="/xui">
    <window_group name="rebirthCampfireProcessingWindow" controller="RebirthCampfireProcessing, RebirthUtils" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="bp.content">
      <window name="windowCraftingList"/>
      <window name="craftingInfoPanel"/>
      <window name="windowCraftingQueue"/>
      <window name="windowToolsCampfire"/>
      <window name="windowFuel"/>
      <window name="windowOutput"/>
      <window name="windowNonPagingHeader"/>
    </window_group>
  </append>
  <remove xpath="/xui/window_group[@name='workstation_campfire']/window" />
  <setattribute xpath="/xui/window_group[@name='workstation_campfire']" name="controller">RebirthCookingStation, RebirthUtils</setattribute>
  <setattribute xpath="/xui/window_group[@name='workstation_campfire']" name="open_backpack_on_open">false</setattribute>
  <append xpath="/xui/window_group[@name='workstation_campfire']">
    <window name="rebirthCookingRoot" anchor="Center" />
  </append>
  <remove xpath="/xui/window_group[@name='workstation_cntWoodBurningStove']/window" />
  <setattribute xpath="/xui/window_group[@name='workstation_cntWoodBurningStove']" name="controller">RebirthCookingStation, RebirthUtils</setattribute>
  <setattribute xpath="/xui/window_group[@name='workstation_cntWoodBurningStove']" name="open_backpack_on_open">false</setattribute>
  <append xpath="/xui/window_group[@name='workstation_cntWoodBurningStove']">
    <window name="rebirthCookingRoot" anchor="Center" />
  </append>
  <remove xpath="/xui/window_group[@name='workstation_WorkbenchGasStove001_FR']/window" />
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchGasStove001_FR']" name="controller">RebirthCookingStation, RebirthUtils</setattribute>
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchGasStove001_FR']" name="open_backpack_on_open">false</setattribute>
  <append xpath="/xui/window_group[@name='workstation_WorkbenchGasStove001_FR']">
    <window name="rebirthCookingRootStove" anchor="Center" />
  </append>
  <remove xpath="/xui/window_group[@name='workstation_WorkbenchIronOven001_FR']/window" />
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchIronOven001_FR']" name="controller">RebirthCookingStation, RebirthUtils</setattribute>
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchIronOven001_FR']" name="open_backpack_on_open">false</setattribute>
  <append xpath="/xui/window_group[@name='workstation_WorkbenchIronOven001_FR']">
    <window name="rebirthCookingRootOven" anchor="Center" />
  </append>
  <remove xpath="/xui/window_group[@name='workstation_WorkbenchMortarPestle001_FR']/window" />
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchMortarPestle001_FR']" name="controller">RebirthCookingStation, RebirthUtils</setattribute>
  <setattribute xpath="/xui/window_group[@name='workstation_WorkbenchMortarPestle001_FR']" name="open_backpack_on_open">false</setattribute>
  <append xpath="/xui/window_group[@name='workstation_WorkbenchMortarPestle001_FR']">
    <window name="rebirthCookingRoot" anchor="Center" />
  </append>
</configs>
