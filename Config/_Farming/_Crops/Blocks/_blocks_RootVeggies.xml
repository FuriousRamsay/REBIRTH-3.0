		<property name="CustomIcon" value="plantedCarrot" />
		<property name="Model" value="#@modfolder:Resources/RB_FarmingCrops.unity3d?CarrotHarvestPrefab.prefab" />
		<drop event="Harvest" name="foodCropCarrot" count="1" tag="wildCropsHarvest" />
		<drop event="Harvest" name="foodCropCarrot" prob="0.5" count="1" tag="bonusCropHarvest" />
		<drop event="Harvest" name="foodCropCarrot" count="1" tag="farmerBonusHarvest" />
	</block>
	<block name="plantedCarrot3HarvestPlayer">
