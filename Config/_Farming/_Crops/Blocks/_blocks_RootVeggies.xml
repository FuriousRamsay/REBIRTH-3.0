		<property name="Extends" value="plantedCrop" />
		<property name="Class" value="PlantGrowingRebirth, RebirthUtils" />
		<property name="CreativeMode" value="Player" />
		<property name="CustomIcon" value="seedCarrot"/>
		<property class="PlantGrowing">
			<property name="Next" value="plantedCarrot2" />
		</property>
		<property name="Model" value="#@modfolder:Resources/RB_FarmingCrops.unity3d?CarrotSproutPrefab.prefab" />
		<drop event="Destroy" name="plantedCarrot1" count="1" />
	</block>
