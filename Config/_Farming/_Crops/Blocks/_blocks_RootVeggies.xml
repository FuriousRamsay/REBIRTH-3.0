		</property>
		<property name="Model" value="#@modfolder:Resources/RB_FarmingCrops.unity3d?CarrotGrowthPrefab.prefab" />
		<drop event="Destroy" name="plantedCarrot1" count="1" />
	</block>
	<block name="plantedCarrot3Harvest">
