	</append>
	<append xpath="/blocks/block[@name='plantedPotato3Harvest']">
		<property name="CustomIcon" value="plantedPotato" />
	</append>
	<append xpath="/blocks/block[starts-with(@name,'plantedPotato')]">
		<property name="ModelOffset" value="0,0,0"/>
