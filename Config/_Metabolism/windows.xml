<configs>
  <!-- Minimal play HUD: Health/Stamina remain above the toolbelt. Energy is a compact
       compass/header indicator containing only a lightning icon and current/max value. -->
  <append xpath="/windows/window[@name='windowCompass']">
    <rect name="rebirthMetabolismHud" pos="251,0" width="70" height="38" controller="RebirthMetabolismHud, RebirthUtils">
      <!-- PC069: preserve the compass controller's 70px Energy reservation while guaranteeing
           the current/max value renders at the authored 15px size. The old 38px label used
           shrinkcontent, which silently reduced the live font. Shift the bolt left and allocate
           a 50px non-shrinking value field so values through 100/100 remain full-size. -->
      <sprite name="rebirthMetabolismEnergyLightningIcon" depth="6" atlas="RebirthHud" sprite="rb_hud_energy_bolt" pivot="center" pos="9,-19" width="18" height="18" color="255,255,255,255" foregroundlayer="true"/>
      <label name="rebirthMetabolismEnergyText" depth="7" pivot="center" pos="45,-21" width="50" height="18" text="{rbmet_hud_energy_current_with_max}" font_size="15" justify="left" color="240,240,240,255" overflow="clampcontent" max_line_count="1"/>
    </rect>
    <sprite depth="3" name="rebirthCompassEnergySeparator" pos="321,-8" width="1" height="22" sprite="menu_empty" color="70,70,70,205"/>
  </append>

  <!-- Character-window Metabolism tab. The panel intentionally extends left of the normal
       327px Character frame so the digestion presentation remains readable without covering the
       center inventory window. -->
  <set xpath="/windows/window[@name='CharacterFrameWindow']/@height">786</set>
  <setattribute xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']" name="height">786</setattribute>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsContents']/@height">724</set>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect/rect[@controller='TabSelectorButton'][1]/@pos">18,0</set>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect/rect[@controller='TabSelectorButton'][2]/@pos">56,0</set>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect/rect[@controller='TabSelectorButton'][3]/@pos">94,0</set>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect/rect[@controller='TabSelectorButton'][4]/@pos">132,0</set>
  <set xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect/rect[@controller='TabSelectorButton'][5]/@pos">170,0</set>

  <append xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsHeader']/rect">
    <rect controller="TabSelectorButton" pos="208,0">
      <button depth="2" pos="0,0" style="icon30px, press" sprite="{tab_sprite}" pivot="center" tooltip="{tab_name_localized}" sound="[paging_click]" selected="{tab_selected}"/>
    </rect>
  </append>

  <append xpath="/windows/window[@name='CharacterFrameWindow']/rect[@name='tabs']/rect[@name='tabsContents']">
    <rect controller="TabSelectorTab" tab_key="rebirth_metabolism" tab_caption_key="xuiRebirthMetabolismCharacterTab" tab_sprite="ui_game_symbol_fork">
      <rect name="rebirthCharacterMetabolism" pos="-215,0" width="545" height="724" controller="RebirthMetabolismCharacterPanel, RebirthUtils" gamepad_selectable="true" snap="false">
        <sprite depth="0" pos="0,0" width="545" height="724" sprite="menu_empty" color="18,18,18,245" type="sliced"/>
        <sprite depth="1" pos="0,0" width="545" height="724" sprite="menu_empty3px" color="0,0,0,255" type="sliced" fillcenter="false"/>

        <!-- Complete transparent greyscale digestive tract. It is reference art only; live state
             stays in the cards. The image uses nearly the full right-hand column. -->
        <sprite depth="4" pos="311,-3" width="222" height="476" atlas="RebirthMetabolism" sprite="rb_metabolism_digestive_tract" color="255,255,255,255"/>

        <!-- Intake -->
        <sprite depth="2" pos="10,-8" width="290" height="132" sprite="menu_empty" color="29,29,29,252" type="sliced"/>
        <sprite depth="3" pos="10,-8" width="290" height="132" sprite="menu_empty3px" color="215,215,215,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="20,-15" width="270" height="27" text_key="xuiRebirthMetabolismIntakeActive" font_size="22" color="245,245,245,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="20,-43" width="270" height="38" text_key="xuiRebirthMetabolismIntakeDesc" font_size="18" color="210,210,210,255" justify="center" overflow="shrinkcontent" max_line_count="2"/>
        <sprite depth="10" pos="22,-79" width="42" height="42" atlas="UIAtlas" sprite="ui_game_symbol_fork" color="210,210,210,180"/>
        <sprite depth="11" pos="20,-77" width="46" height="46" atlas="ItemIconAtlas" sprite="{rbmet_intake_icon}" visible="{rbmet_intake_item_visible}" color="255,255,255,255"/>
        <label depth="12" pos="77,-76" width="211" height="22" text="{rbmet_intake_name}" font_size="17" color="240,240,240,255" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="77,-98" width="211" height="18" text="{rbmet_intake_amount}" font_size="15" color="198,207,212,255" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="77,-116" width="211" height="17" text="{rbmet_intake_summary}" font_size="13" color="225,225,225,255" overflow="shrinkcontent" max_line_count="1"/>

        <!-- Stomach -->
        <sprite depth="2" pos="10,-148" width="290" height="176" sprite="menu_empty" color="38,31,26,252" type="sliced"/>
        <sprite depth="3" pos="10,-148" width="290" height="176" sprite="menu_empty3px" color="215,112,30,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="20,-156" width="270" height="29" text_key="xuiRebirthMetabolismStomach" font_size="23" color="245,190,105,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="20,-186" width="270" height="38" text_key="xuiRebirthMetabolismStomachDesc" font_size="18" color="218,207,198,255" justify="center" overflow="shrinkcontent" max_line_count="2"/>
        <label depth="12" pos="20,-226" width="270" height="22" text="{rbmet_fullness}" font_size="18" color="242,242,242,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <sprite depth="8" pos="22,-250" width="266" height="15" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="24,-252" width="262" height="11" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="{rbmet_stomach_fill}" color="225,125,35,255"/>
        <label depth="12" pos="22,-273" width="266" height="22" text="{rbmet_stomach_liquid_state}" font_size="16" color="245,245,245,255" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="22,-299" width="266" height="22" text="{rbmet_stomach_solid_state}" font_size="16" color="245,245,245,255" overflow="shrinkcontent" max_line_count="1"/>

        <!-- Intestine -->
        <sprite depth="2" pos="10,-332" width="290" height="184" sprite="menu_empty" color="31,27,38,252" type="sliced"/>
        <sprite depth="3" pos="10,-332" width="290" height="184" sprite="menu_empty3px" color="145,95,205,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="20,-340" width="270" height="29" text_key="xuiRebirthMetabolismIntestine" font_size="23" color="198,160,232,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="20,-370" width="270" height="38" text_key="xuiRebirthMetabolismIntestineDesc" font_size="18" color="213,205,221,255" justify="center" overflow="shrinkcontent" max_line_count="2"/>
        <label depth="12" pos="20,-410" width="270" height="22" text="{rbmet_intestinal_content}" font_size="18" color="242,242,242,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <sprite depth="8" pos="22,-434" width="266" height="15" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="24,-436" width="262" height="11" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="{rbmet_intestine_fill}" color="155,105,210,255"/>
        <label depth="12" pos="22,-459" width="266" height="22" text="{rbmet_intestine_liquid_state}" font_size="16" color="245,245,245,255" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="22,-486" width="266" height="22" text="{rbmet_intestine_solid_state}" font_size="16" color="245,245,245,255" overflow="shrinkcontent" max_line_count="1"/>

        <!-- Optional player explanation. This opens a separate instructional window and does not
             expose debug or implementation bookkeeping. -->
        <labeledbutton name="btnRebirthMetabolismInformation" depth="12" pos="306,-486" width="229" height="30" font_size="18" caption_key="xuiRebirthMetabolismInformation" gamepad_selectable="false" snap="false"/>

        <!-- Body reserves -->
        <sprite depth="2" pos="10,-524" width="257" height="88" sprite="menu_empty" color="25,36,43,252" type="sliced"/>
        <sprite depth="3" pos="10,-524" width="257" height="88" sprite="menu_empty3px" color="55,145,205,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="19,-531" width="239" height="25" text_key="xuiRebirthMetabolismHydration" font_size="21" color="105,190,240,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="19,-556" width="239" height="20" text="{rbmet_hydration}" font_size="17" color="245,245,245,255" justify="center"/>
        <sprite depth="8" pos="22,-579" width="233" height="10" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="24,-581" width="229" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_water" type="filled" fill="{rbmet_hydration_fill}" color="255,255,255,255"/>
        <label depth="12" pos="19,-592" width="239" height="16" text="NET {rbmet_hydration_net_compact}" font_size="12" color="175,223,252,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>

        <sprite depth="2" pos="277,-524" width="258" height="88" sprite="menu_empty" color="29,39,24,252" type="sliced"/>
        <sprite depth="3" pos="277,-524" width="258" height="88" sprite="menu_empty3px" color="80,165,55,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="286,-531" width="240" height="25" text_key="xuiRebirthMetabolismNutrition" font_size="21" color="135,210,105,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="286,-556" width="240" height="20" text="{rbmet_food}" font_size="17" color="245,245,245,255" justify="center"/>
        <sprite depth="8" pos="289,-579" width="234" height="10" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="291,-581" width="230" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_food" type="filled" fill="{rbmet_food_fill}" color="255,255,255,255"/>
        <label depth="12" pos="286,-592" width="240" height="16" text="NET {rbmet_nutrition_net_compact}" font_size="12" color="190,228,170,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>

        <!-- Digestive Health -->
        <sprite depth="2" pos="10,-620" width="257" height="96" sprite="menu_empty" color="34,34,35,252" type="sliced"/>
        <sprite depth="3" pos="10,-620" width="257" height="96" sprite="menu_empty3px" color="145,150,155,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="19,-627" width="239" height="25" text_key="xuiRebirthMetabolismDigestiveHealth" font_size="21" color="205,210,215,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="19,-653" width="239" height="20" text="{rbmet_digestive_health}" font_size="17" color="245,245,245,255" justify="center"/>
        <sprite depth="8" pos="22,-676" width="233" height="10" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="24,-678" width="229" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="{rbmet_digestive_health_fill}" color="155,160,165,255"/>
        <label depth="12" pos="19,-692" width="239" height="18" text="{rbmet_digestive_health_summary}" font_size="12" color="205,210,215,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>

        <!-- Energy / endurance -->
        <sprite depth="2" pos="277,-620" width="258" height="96" sprite="menu_empty" color="42,39,22,252" type="sliced"/>
        <sprite depth="3" pos="277,-620" width="258" height="96" sprite="menu_empty3px" color="225,195,55,255" type="sliced" fillcenter="false"/>
        <label depth="12" pos="286,-627" width="240" height="25" text_key="xuiRebirthMetabolismEnergy" font_size="21" color="245,215,85,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <label depth="12" pos="286,-653" width="240" height="20" text="{rbmet_energy_compact}" font_size="16" color="245,239,220,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
        <sprite depth="8" pos="289,-676" width="234" height="10" sprite="menu_empty" type="sliced" color="12,12,12,255"/>
        <filledsprite depth="9" pos="291,-678" width="230" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="1" color="0,0,0,255"/>
        <filledsprite depth="10" pos="291,-678" width="230" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="{rbmet_energy_capacity_fill}" color="110,110,110,190"/>
        <filledsprite depth="11" pos="291,-678" width="230" height="6" atlas="RebirthHud" sprite="rb_hud_vital_fill_neutral" type="filled" fill="{rbmet_energy_fill}" color="{rbmet_energy_color}"/>
        <label depth="12" pos="286,-692" width="240" height="18" text="{rbmet_energy_rates_compact}" font_size="12" color="235,225,185,255" justify="center" overflow="shrinkcontent" max_line_count="1"/>
      </rect>
    </rect>
  </append>

  <!-- Player-facing explanation of the metabolism pipeline. -->
  <append xpath="/windows">
    <window name="rebirthMetabolismInformationWindow" anchor="Center" depth="45" pos="-380,360" width="760" height="720" controller="RebirthMetabolismInformationWindow, RebirthUtils" lock_navigation="true" cursor_area="true">
      <fullscreencollider_new color="0,0,0,190"/>
      <sprite depth="1" pos="0,0" width="760" height="720" sprite="menu_empty" color="18,18,18,255" type="sliced"/>
      <sprite depth="2" pos="0,0" width="760" height="720" sprite="menu_empty3px" color="110,110,110,255" type="sliced" fillcenter="false"/>
      <label depth="5" pos="25,-18" width="710" height="34" text_key="xuiRebirthMetabolismInformation" font_size="28" justify="center" color="245,245,245,255" overflow="shrinkcontent" max_line_count="1"/>
      <label depth="5" pos="35,-61" width="690" height="46" text_key="xuiRebirthMetabolismInfoIntro" font_size="19" justify="center" color="220,220,220,255" overflow="shrinkcontent" max_line_count="2"/>

      <sprite depth="3" pos="25,-118" width="710" height="94" sprite="menu_empty" color="35,31,28,245" type="sliced"/>
      <label depth="5" pos="40,-128" width="680" height="25" text_key="xuiRebirthMetabolismInfoStomachTitle" font_size="22" color="245,190,105,255"/>
      <label depth="5" pos="40,-158" width="680" height="50" text_key="xuiRebirthMetabolismInfoStomachBody" font_size="18" color="235,235,235,255" overflow="shrinkcontent" max_line_count="3"/>

      <sprite depth="3" pos="25,-220" width="710" height="102" sprite="menu_empty" color="31,27,38,245" type="sliced"/>
      <label depth="5" pos="40,-230" width="680" height="25" text_key="xuiRebirthMetabolismInfoIntestineTitle" font_size="22" color="198,160,232,255"/>
      <label depth="5" pos="40,-260" width="680" height="58" text_key="xuiRebirthMetabolismInfoIntestineBody" font_size="18" color="235,235,235,255" overflow="shrinkcontent" max_line_count="3"/>

      <sprite depth="3" pos="25,-330" width="710" height="102" sprite="menu_empty" color="28,34,31,245" type="sliced"/>
      <label depth="5" pos="40,-340" width="680" height="25" text_key="xuiRebirthMetabolismInfoEnergyTitle" font_size="22" color="245,215,85,255"/>
      <label depth="5" pos="40,-370" width="680" height="58" text_key="xuiRebirthMetabolismInfoEnergyBody" font_size="18" color="235,235,235,255" overflow="shrinkcontent" max_line_count="3"/>

      <sprite depth="3" pos="25,-440" width="710" height="86" sprite="menu_empty" color="34,34,35,245" type="sliced"/>
      <label depth="5" pos="40,-450" width="680" height="25" text_key="xuiRebirthMetabolismInfoHealthTitle" font_size="22" color="205,210,215,255"/>
      <label depth="5" pos="40,-480" width="680" height="42" text_key="xuiRebirthMetabolismInfoHealthBody" font_size="18" color="235,235,235,255" overflow="shrinkcontent" max_line_count="2"/>

      <sprite depth="3" pos="25,-534" width="710" height="116" sprite="menu_empty" color="30,30,30,245" type="sliced"/>
      <label depth="5" pos="40,-544" width="680" height="25" text_key="xuiRebirthMetabolismInfoExampleTitle" font_size="22" color="245,245,245,255"/>
      <label depth="5" pos="40,-574" width="680" height="72" text_key="xuiRebirthMetabolismInfoExampleBody" font_size="17" color="235,235,235,255" overflow="shrinkcontent" max_line_count="4"/>

      <labeledbutton name="btnRebirthMetabolismInformationClose" depth="8" pos="280,-670" width="200" height="36" font_size="20" caption_key="xuiClose" gamepad_selectable="false" snap="false"/>
    </window>
  </append>

</configs>