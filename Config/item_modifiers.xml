      <property name="Extends" value="modGeneralMaster"/><property name="CustomIcon" value="FireShockSmokeResistAura"/><property name="DisplayType" value="FuriousRamsayFireShockSmokeResist"/><property name="Material" value="Mleather"/><property name="Stacknumber" value="1"/><property name="SellableToTrader" value="true"/><property name="EconomicValue" value="250"/><property name="Group" value="Mods"/><property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
