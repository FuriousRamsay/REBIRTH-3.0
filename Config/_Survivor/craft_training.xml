<?xml version="1.0" encoding="utf-8"?>
<!-- Fix35: tuning, not native character-level XP. One completed recipe cycle is one unit of practice.
     raw = existing skill base * consumed material effort / reference * complexity * practice.
     complexity = 1 + min(authored seconds,120)/120 + min(0.5,(different input types-1)*0.1).
     Difficulty uses material effort, variety, time and the existing skill recommendation.
     Beyond difficulty, gain fades to zero over practice_fade_levels. Output count never multiplies XP.
     Unlisted materials use EconomicValue / EconomicBundleSize / divisor, bounded to 0.02..20.
     Explicit per-recipe multiplier=0 disables packing/recycling exploits; overrides are optional. -->
<craft_training schema_version="1" reference_effort="10" maximum_raw_per_cycle="0.6"
                practice_fade_levels="20" economic_value_divisor="20" unknown_material_weight="0.25">
  <!-- These existing recipe owners had no legacy craft-rate branch; never substitute a new skill. -->
  <skill id="skill.archery" base_rate="0.12" />
  <skill id="skill.drone_operations" base_rate="0.12" />
  <skill id="skill.armor_proficiency" base_rate="0.12" />
  <skill id="skill.animal_processing" base_rate="0.12" />
