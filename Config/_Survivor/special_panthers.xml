<?xml version="1.0" encoding="utf-8"?>
<configs>
  <append xpath="/buffs">
    <buff name="RebirthHorrorPantherSupport" hidden="true" remove_on_death="false">
      <stack_type value="ignore"/>
      <effect_group><triggered_effect trigger="onSelfDamagedOther" action="RebirthSpecialPantherAssist, RebirthUtils"/></effect_group>
    </buff>
    <buff name="RebirthRagePantherMonitor" hidden="true" remove_on_death="false">
      <stack_type value="ignore"/>
      <effect_group>
        <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$RB_RagePantherHits" operation="set" value="0"/>
        <triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar" cvar="$RB_RagePantherHits" operation="add" value="1"><requirement name="NotHasBuff" buff="RebirthRagePantherCooldown"/></triggered_effect>
        <triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" buff="RebirthRagePantherActive"><requirement name="CVarCompare" cvar="$RB_RagePantherHits" operation="GTE" value="2"/><requirement name="NotHasBuff" buff="RebirthRagePantherCooldown"/></triggered_effect>
      </effect_group>
    </buff>
    <buff name="RebirthRagePantherActive" hidden="true" remove_on_death="true">
      <stack_type value="replace"/><duration value="8"/>
      <effect_group><passive_effect name="EntityDamage" operation="perc_add" value=".35"/><passive_effect name="RunSpeed" operation="perc_add" value=".20"/><triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$RB_RagePantherHits" operation="set" value="0"/><triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="RebirthRagePantherCooldown"/></effect_group>
    </buff>
    <buff name="RebirthRagePantherCooldown" hidden="true" remove_on_death="true"><stack_type value="replace"/><duration value="20"/></buff>
  </append>
</configs>
