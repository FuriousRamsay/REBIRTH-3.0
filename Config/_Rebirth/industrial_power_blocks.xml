<configs>
  <!-- World POI generator salvage: native damage/destruction awards one repairable shell.
       Ordinary placed power banks retain their existing component/ownership lifecycle. -->
  <set xpath="/blocks/block[@name='questGeneratorSmall']/property[@name='MaxDamage']/@value">500</set>
  <remove xpath="/blocks/block[@name='questGeneratorSmall']/drop" />
  <append xpath="/blocks/block[@name='questGeneratorSmall']">
    <drop event="Destroy" name="FuriousRamsayCollapsedGeneratorBank" count="1" prob="1" />
    <drop event="Fall" name="FuriousRamsayCollapsedGeneratorBank" count="1" prob="1" stick_chance="1" />
  </append>
  <append xpath="/blocks">
    <block name="FuriousRamsayGeneratorBank">
      <property name="Extends" value="generatorbank"/>
      <property name="UnlockedBy" value=""/>
      <property name="CustomIcon" value="generatorBankA"/>
      <property name="DescriptionKey" value="FuriousRamsayGeneratorBankDesc"/>
      <property name="MaxFuel" value="2000"/>
      <property name="OutputPerStack" value="150"/>
      <property name="EconomicValue" value="1200"/>
    </block>
    <block name="FuriousRamsayBatteryBank">
      <property name="Extends" value="batterybank"/>
      <property name="UnlockedBy" value=""/>
      <property name="CustomIcon" value="batterybank"/>
      <property name="DescriptionKey" value="FuriousRamsayBatteryBankDesc"/>
      <property name="OutputPerStack" value="75"/>
      <property name="MaxPower" value="600"/>
      <property name="InputPerTick" value="10"/>
      <property name="EconomicValue" value="1000"/>
    </block>
  </append>
</configs>
