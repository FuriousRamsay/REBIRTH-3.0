  <remove xpath="/lootcontainers/lootgroup[@name='rebirthPurgeSupplyModifierTier1']/item[@group='empty']" />
  <append xpath="/lootcontainers/lootgroup[@name='rebirthPurgeSupplyModifierTier1']"><item group="rebirthModPoolT1" prob="17.45" /></append>
