    <!-- P2 dog deployment item/block base. This is a placement token, not a durable world block. -->
    <block name="RebirthDogSpawnCubeBase">
      <property name="Extends" value="woodNoUpgradeMaster"/>
      <property name="CreativeMode" value="Dev"/>
      <property name="Model" value="#@modfolder:Resources/PathingCube.unity3d?PathingCube"/>
      <property name="Shape" value="ModelEntity"/>
      <property name="HandleFace" value="South"/>
      <property name="MultiBlockDim" value="1,1,1"/>
      <property name="StabilitySupport" value="false"/>
      <property name="Place" value="TowardsPlacerInverted"/>
      <property name="Group" value="Ammo/Weapons"/>
      <property name="Collide" value="sight"/>
      <drop event="Fall" count="0" prob="0"/>
    </block>

    <block name="FuriousRamsaySpawnCubeShepherdDog001_FR">
      <property name="Extends" value="RebirthDogSpawnCubeBase"/>
      <property name="Class" value="RebirthDogDeployBlock, RebirthUtils"/>
      <property name="RebirthDogBreedId" value="german_shepherd"/>
      <property name="Tags" value="dog,animal"/>
      <property name="CreativeMode" value="Player"/>
      <property name="CustomIcon" value="Shepherd001_FR_icon"/>
      <property name="DescriptionKey" value="FuriousRamsaySpawnCubeShepherd001_FRDesc"/>
      <property name="Config" value="ec=FuriousRamsayNPCShepherd001_FR;buff=buffOrderFollow;pc=0;leader=true"/>
      <property name="EconomicValue" value="350"/>
      <property name="SellableToTrader" value="false"/>
      <property name="DisplayType" value=""/>
      <property name="ModelOffset" value="0,0,0"/>
      <property name="Stacknumber" value="50"/>
      <property name="MaxDamage" value="400"/>
      <property name="LightOpacity" value="25"/>
      <property name="MultiBlockDim" value="1,1,2"/>
      <property name="Model" value="#@modfolder:Resources/FR_Animals.unity3d?Shepherd001_Preview_FR"/>
