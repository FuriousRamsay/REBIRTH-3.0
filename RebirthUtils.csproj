<Target Name="RunRebirthProfilerInstrumentation" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(RebirthProfilerEnableInstrumentation)' == 'true' and Exists('$(TargetPath)')">
		<Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\Tools\RebirthProfiler.Instrumenter\RebirthProfiler.Instrumenter.csproj&quot; -- &quot;$(TargetPath)&quot; --scope $(RebirthProfilerScope)" />
	</Target>

	<Target Name="ValidateRebirthB259References" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RebirthValidateB259References)' == 'true'">
		<Error Condition="!Exists('$(RebirthManagedRoot)\Assembly-CSharp.dll')" Text="REBIRTH b259 build reference missing: $(RebirthManagedRoot)\Assembly-CSharp.dll. Pass -p:RebirthGameRoot=&lt;7 Days To Die root&gt;." />
		<Error Condition="!Exists('$(RebirthManagedRoot)\UnityEngine.CoreModule.dll')" Text="REBIRTH b259 Unity reference missing: $(RebirthManagedRoot)\UnityEngine.CoreModule.dll." />
		<Message Importance="high" Text="REBIRTH NPC b259 reference root: $(RebirthManagedRoot)" />
	</Target>

	<Target Name="RebirthValidateBuildConfiguration" BeforeTargets="CoreCompile">
		<Error Condition="'$(Configuration)' != 'Debug' and '$(RebirthProfilerEnableInstrumentation)' == 'true'"
		       Text="REBIRTH debug/profiling instrumentation cannot be enabled in a non-Debug build." />
	</Target>
  <!-- Framework reference resolution otherwise replaces the explicit game mscorlib
       with net481's reference assembly, which lacks the installed native Span API. -->
  <Target Name="RebirthResolveNativeCoreLibrary" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
            <_RebirthNativeFramework Include="@(ReferencePath)" Condition="('%(ReferencePath.Filename)' == 'mscorlib' Or '%(ReferencePath.Filename)' == 'System' Or '%(ReferencePath.Filename)' == 'System.Core' Or '%(ReferencePath.Filename)' == 'System.Data' Or '%(ReferencePath.Filename)' == 'System.Drawing' Or '%(ReferencePath.Filename)' == 'System.IO.Compression.FileSystem' Or '%(ReferencePath.Filename)' == 'System.Numerics' Or '%(ReferencePath.Filename)' == 'System.Runtime.Serialization' Or '%(ReferencePath.Filename)' == 'System.Xml' Or '%(ReferencePath.Filename)' == 'System.Xml.Linq' Or '%(ReferencePath.Filename)' == 'netstandard') And Exists('$(RebirthManagedRoot)\%(ReferencePath.Filename).dll')" />
      <ReferencePath Remove="@(_RebirthNativeFramework)" />
      <ReferencePath Include="@(_RebirthNativeFramework->'$(RebirthManagedRoot)\%(Filename).dll')">
        <Private>False</Private>
        <CopyLocal>false</CopyLocal>
      </ReferencePath>
    </ItemGroup>
  </Target>
