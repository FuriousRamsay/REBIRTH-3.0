<IsPackable>false</IsPackable>
		<OutDir>.</OutDir>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<RebirthProfilerEnableInstrumentation>false</RebirthProfilerEnableInstrumentation>
		<RebirthProfilerScope>top</RebirthProfilerScope>
		<!-- 3.1 migration: exact-game-root override for reproducible builds. -->
		<RebirthGameRoot Condition="'$(RebirthGameRoot)' == ''">$(MSBuildProjectDirectory)\..\..</RebirthGameRoot>
		<RebirthManagedRoot Condition="'$(RebirthManagedRoot)' == ''">$(RebirthGameRoot)\7DaysToDie_Data\Managed</RebirthManagedRoot>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);REBIRTH_DEBUG</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
